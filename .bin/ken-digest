#!/bin/sh
# `ken digest [<transcript>]`: writes the root's record of one agent session,
# .sessions/<id>.md, from the harness's transcript, KEN_SESSION_TRANSCRIPT or the argument, whole
# each time, so running it twice gives the same file. The digest is the user's prompts, the
# agent's replies and one line per tool call, `- <tool> <head of its input>`, in transcript
# order; never tool results, attachments, system reminders, thinking or images: they are the
# bulk and where secrets live. `ken log` runs it before each line it tags with `s=<id>`.
# A missing or unreadable transcript, or no jq, is a message and exit 0, so `ken log` still logs.
if [ -z "${KEN_ROOT-}" ]; then
	echo "ken digest: KEN_ROOT is not set, so the root is unknown. Run it as \`ken digest\`, which sets it." >&2
	exit 2
fi
t=${1:-${KEN_SESSION_TRANSCRIPT-}}
if [ -z "$t" ]; then
	echo "ken digest: no transcript: KEN_SESSION_TRANSCRIPT is unset and none was given, so no digest was written. The session-start hook sets it; \`ken digest <transcript>\` names one." >&2
	exit 0
fi
if [ ! -r "$t" ]; then
	echo "ken digest: the transcript $t cannot be read, so no digest was written: the harness may have deleted it." >&2
	exit 0
fi
if ! command -v jq >/dev/null 2>&1; then
	echo "ken digest: jq is not installed, so no digest was written. The transcript is JSON lines and jq reads them: \`brew install jq\` or \`apt install jq\`, then \`ken digest $t\` writes this session's." >&2
	exit 0
fi
# The format: pi's session header or Codex's session_meta is the first line; Claude Code's
# entries carry sessionId, though the first may be a file-history snapshot that has none.
case $(head -n 1 "$t") in
*'"type":"session"'*) harness=pi ;;
*'"type":"session_meta"'*) harness=codex ;;
*) harness=claude-code ;;
esac
if [ $harness = claude-code ] && ! grep -q '"sessionId"' "$t"; then
	echo "ken digest: $t is no transcript ken reads (Claude Code, pi or Codex), so no digest was written." >&2
	exit 0
fi
mkdir -p "$KEN_ROOT/.sessions" || exit 1
tmp=$KEN_ROOT/.sessions/.digest.$$
# The transcript is read raw and split at newlines, so a line that is not JSON, one still being
# written, is skipped rather than failing the whole file. An entry becomes events: `you`, a
# prompt heading with its time; `prompt`; `said`; `tool`; `note`. Rendering puts a `## claude`
# heading before the agent's first event after a prompt, a blank line between blocks, none
# between tool lines.
jq -R -s -j --arg harness "$harness" '
def stamp: sub("\\.[0-9]+Z$"; "Z");
def clean: sub("^[ \\t\\n]+"; "") | sub("[ \\t\\n]+$"; "");
# Harness-made text, a background task finishing, a command output, a reminder, is not the user speaking.
def spoken:
  (test("^<(task-notification|bash-stdout|local-command-)") | not)
  and ($harness != "codex" or (test("^(<(environment_context|user_instructions|external_codex_apps_open_page)>|# AGENTS\\.md instructions)") | not));
# A user message: its text, a string or text blocks, under one heading with its time; a reminder
# the harness put in a prompt is cut out, wherever it sits.
def you($content; $time):
  [ ($content | if type == "string" then . else (.[]? | select(.type == "text" or .type == "input_text") | .text) end)
    | strings | gsub("<system-reminder>.*?</system-reminder>"; ""; "m") | clean | select(length > 0 and spoken) ]
  | if length == 0 then empty else {k: "you", s: ($time | stamp)}, (.[] | {k: "prompt", s: .}) end;
# A tool call, one line: its name and the command, the path, or else its input strings in
# order, on one line and cut at 120 characters.
def head:
  (if type == "object" then first((.command, .cmd, .file_path, .path) | strings) else empty end)
  // ([.. | strings] | join(" "))
  | gsub("[ \\t\\r\\n]+"; " ") | sub("^ "; "")
  | if length > 120 then .[:120] + "…" else . end;
def tool($name; $input):
  {k: "tool", s: ("- " + ($name // "") + ($input | head | if . == "" then "" else " " + . end))};
def blocks($content):
  $content | .[]?
  | if .type == "text" or .type == "output_text" then ({k: "said", s: ((.text // "") | clean)} | select(.s != ""))
    elif .type == "tool_use" then tool(.name; .input)
    elif .type == "toolCall" then tool(.name; .arguments)
    else empty end;
# Claude Code: entries in file order; isMeta text is the harness speaking, a compact summary is
# the model rewriting the past, and a rewound branch stays in the file and in the digest.
def claude:
  if .type == "system" and .subtype == "compact_boundary" then {k: "note", s: "(compacted here)"}
  elif .type == "user" and .isMeta != true and .isCompactSummary != true then you(.message.content; .timestamp // "")
  elif .type == "assistant" then blocks(.message.content)
  else empty end;
# pi: a tree, id and parentId; the digest is the path from the last entry back to the root.
def pi:
  if .type == "compaction" then {k: "note", s: "(compacted here)"}
  elif .type == "branch_summary" then {k: "note", s: "(branched here: the path below left another)"}
  elif .type == "message" and .message.role == "user" then you(.message.content; .timestamp // "")
  elif .type == "message" and .message.role == "assistant" then blocks(.message.content)
  else empty end;
def pi_path:
  (map(select(has("id"))) | map({key: (.id | tostring), value: .}) | from_entries) as $by
  | [ {id: (map(select(has("id")))[-1].id // "" | tostring), seen: {}, path: []}
      | until(.id == "" or .seen[.id]; .seen[.id] = true | .path += [.id] | .id = ($by[.id].parentId // "" | tostring))
      | .path[] ] | reverse | map($by[.]);
# Codex: the response items in file order; a function call carries its arguments as JSON text.
def codex:
  if .type == "compacted" then {k: "note", s: "(compacted here)"}
  elif .type != "response_item" then empty
  elif .payload.type == "message" and .payload.role == "user" then you(.payload.content; .timestamp // "")
  elif .payload.type == "message" and .payload.role == "assistant" then blocks(.payload.content)
  elif .payload.type == "custom_tool_call" then tool(.payload.name; .payload.input)
  elif .payload.type == "function_call" then tool(.payload.name; (.payload.arguments | if type == "string" then (try fromjson catch .) else . end))
  else empty end;
def render($name):
  reduce .[] as $e ({agent: false, last: "", out: ""};
    if $e.k == "you" then .out += "\n## you " + $e.s + "\n" | .agent = false | .last = "h"
    else
      (if ($e.k == "said" or $e.k == "tool") and (.agent | not) then .out += "\n## " + $name + "\n" | .agent = true | .last = "h" else . end)
      | .out += (if $e.k == "tool" and .last == "tool" then "" else "\n" end) + $e.s + "\n"
      | .last = (if $e.k == "tool" then "tool" else "text" end)
    end) | .out;
def header($session; $started; $cwd):
  "---\nsession: " + ($session // "") + "\nharness: " + $harness + "\nstarted: " + (($started // "") | stamp) + "\ncwd: " + ($cwd // "") + "\n---\n";
split("\n") | map(select(length > 0) | fromjson? | select(type == "object"))
| if $harness == "pi" then
    (.[0] | header(.id; .timestamp; .cwd)) + (pi_path | [.[] | pi] | render("pi"))
  elif $harness == "codex" then
    (.[0].payload | header(.id; .timestamp; .cwd)) + ([.[] | codex] | render("codex"))
  else
    header(first(.[] | .sessionId | strings); first(.[] | .timestamp | strings); first(.[] | .cwd | strings))
    + ([.[] | claude] | render("claude"))
  end
' "$t" >"$tmp" || {
	rm -f "$tmp"
	echo "ken digest: reading $t failed, so no digest was written." >&2
	exit 1
}
# The session ken log tags its line with; a transcript named by hand is its own session's.
id=$(sed -n '2s/^session: //p' "$tmp")
if [ $# -eq 0 ]; then
	id=${KEN_SESSION:-$id}
fi
case $id in
'' | .* | */* | *' '*)
	rm -f "$tmp"
	echo "ken digest: '$id' is no session id: it names the file .sessions/<id>.md. KEN_SESSION is the harness's id, set by the session-start hook." >&2
	exit 2
	;;
esac
mv "$tmp" "$KEN_ROOT/.sessions/$id.md"
