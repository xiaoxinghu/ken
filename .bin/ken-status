#!/bin/sh
# The session-start hook, run as `.bin/ken status`: one screen of what this root holds, so the
# agent never lists folders, and `ken` on the PATH of the agent's shell where the harness has a
# way. Exit 0 always: the output is the agent's context, the errors included.
q() { printf '%s' "$1" | sed "s/'/'\\\\''/g"; }
# The hook's stdin JSON names the session and its transcript, which `ken log` needs for the
# digest; a person running it at a terminal sends none.
session='' transcript='' input=''
if [ ! -t 0 ]; then
	input=$(cat)
	session=$(printf '%s\n' "$input" | sed -n 's/.*"session_id" *: *"\([^"]*\)".*/\1/p')
	transcript=$(printf '%s\n' "$input" | sed -n 's/.*"transcript_path" *: *"\([^"]*\)".*/\1/p')
fi
# Claude Code sources CLAUDE_ENV_FILE before each shell command. ken dispatch put its own .bin/
# first on this PATH, so the same folder goes there, and KEN_ROOT, so `ken` in a checkout, which
# has no .ken above it, acts on this root. A harness with no such file gets the session in
# .ken-session, git-ignored, which `ken log` reads when the environment has none.
if [ -n "${CLAUDE_ENV_FILE-}" ]; then
	printf "export KEN_ROOT='%s' PATH='%s':\"\$PATH\"\n" "$(q "$KEN_ROOT")" "$(q "$KEN_ROOT/.bin")" >>"$CLAUDE_ENV_FILE"
	if [ -n "$session" ]; then
		printf "export KEN_SESSION='%s' KEN_SESSION_TRANSCRIPT='%s'\n" "$(q "$session")" "$(q "$transcript")" >>"$CLAUDE_ENV_FILE"
	fi
elif [ -n "$session" ]; then
	printf 'KEN_SESSION=%s\nKEN_SESSION_TRANSCRIPT=%s\n' "$session" "$transcript" >"$KEN_ROOT/.ken-session"
else
	# a hook that names no session, pi's shim, starts one all the same: the file is stale
	case $input in *'"hook_event_name"'*) rm -f "$KEN_ROOT/.ken-session" ;; esac
fi
echo "This is a ken root: $KEN_ROOT. Its CLI is \`ken\`, at .bin/ken here; \`ken help\` lists the commands."
echo
ken repos 2>&1
echo
echo 'Settings, .ken:'
sed 's/^/  /' "$KEN_ROOT/.ken" 2>&1
if command -v ken-task >/dev/null 2>&1; then
	echo
	ken task ready 2>&1
fi
# The last entries of the timeline the agents write with `ken log`, never the whole file. A
# union merge can leave lines out of order; sort puts back those that share an offset.
if [ -s "$KEN_ROOT/log.md" ]; then
	echo
	echo "Recent, log.md (now $(date +%Y-%m-%dT%H:%M%z)); grep it for older entries, never read it whole:"
	LC_ALL=C sort "$KEN_ROOT/log.md" | tail -n 10
fi
exit 0
