{
	"$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
	"files": { "includes": ["**", "!**/SKILL.md"] },
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true, "defaultBranch": "main" },
	"formatter": { "indentStyle": "tab", "bracketSpacing": true, "lineWidth": 100 },
	"javascript": {
		"formatter": { "quoteStyle": "single", "semicolons": "asNeeded", "trailingCommas": "none" }
	},
	"linter": {
		"rules": {
			"preset": "recommended",
			"correctness": { "noUnusedVariables": "error", "noUnusedImports": "error" }
		}
	}
}
