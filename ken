#!/bin/sh
# ken: the kernel of a ken root. One POSIX sh file; its only dependency is git.
# The spec is docs/prd.md, "The kernel"; the files it reads are docs/files.md.
#
# Hazards, designed around everywhere below:
# - An exit inside $(...) ends only the subshell, so a function that can die is called as
#   x=$(f) || exit 1, or sets variables in this shell instead of printing.
# - A && B || C is not if-then-else: C runs when B fails too. Write if.
# - sed -i, stat and readlink -f differ between macOS and GNU, so they are not used.
# - Paths pass through git with -z.
# - CDPATH makes cd go elsewhere and print, so it is unset.
# - sh has no local: a function's variables are global, so each is named apart from its
#   callers'.
# shellcheck disable=SC2016 # backquotes in messages are commands to run, not expansions
set -eu
unset CDPATH

nl='
'
tab=$(printf '\t')
BUILTINS='init path which get repos index layer help'

# --- prelude

die() {
	printf 'ken: %s\n' "$*" >&2
	exit 1
}

# $1 as one shell word: as is when nothing in it is special to a shell, else single-quoted.
q() {
	case $1 in
	'' | *[!A-Za-z0-9_./@%+=:,-]*) printf "'%s'" "$(printf '%s\n' "$1" | sed "s/'/'\\\\''/g")" ;;
	*) printf '%s' "$1" ;;
	esac
}

# The real path of the folder $1: symlinks resolved, and on a case-insensitive disk the
# case as stored, so roots compare as real paths (PRD decision 15).
real() { (cd -P -- "$1" && pwd -P); }

# The real path of $1, which need not exist: walked a part at a time, each symlink followed
# where it is met, to a file or to nothing too (40 at most, so a cycle ends), so a .. always
# climbs a real folder; then the longest existing folder is made real, for the case stored on
# a case-insensitive disk. Call as p=$(real_path "$1") || exit 1.
real_path() {
	case $1 in /*) todo=$1 ;; *) todo=$(pwd -P)/$1 ;; esac
	head='' hops=0
	while [ -n "$todo" ]; do
		part=${todo%%/*}
		case $todo in */*) todo=${todo#*/} ;; *) todo='' ;; esac
		case $part in
		'' | .) ;;
		..) head=${head%/*} ;;
		*)
			if [ -L "$head/$part" ] && [ $hops -lt 40 ]; then
				hops=$((hops + 1))
				link=$(readlink "$head/$part")
				case $link in /*) head='' ;; esac
				todo=$link/$todo
			else
				head=$head/$part
			fi
			;;
		esac
	done
	rest=''
	while [ -n "$head" ] && [ ! -d "$head" ]; do rest=/${head##*/}$rest head=${head%/*}; done
	head=$(real "${head:-/}") || return 1
	head=${head%/}$rest
	printf '%s\n' "${head:-/}"
}

lower() { printf '%s\n' "$1" | tr '[:upper:]' '[:lower:]'; }

# $1 without the userinfo (user:token@) of any URL in it, so a message never shows a secret.
redact() {
	printf '%s\n' "$1" | sed -E \
		-e 's#([A-Za-z][A-Za-z0-9+.-]*://)[^/[:space:]]*@#\1#g' \
		-e 's#(^|[[:space:]])[^/:[:space:]]*@([^@:/[:space:]]+:)#\1\2#g'
}

# Whether nothing, not even a dangling link, is at $1.
absent() { [ ! -e "$1" ] && [ ! -L "$1" ]; }

dir_of() {
	case $1 in
	*/*) printf '%s\n' "${1%/*}" ;;
	*) printf '.\n' ;;
	esac
}

# --- the root

# The root this file lives in as <root>/.bin/ken, through any symlinks to it, else nothing.
script_root() {
	self=$0
	while [ -L "$self" ]; do
		link=$(readlink "$self")
		case $link in
		/*) self=$link ;;
		*) self=$(dir_of "$self")/$link ;;
		esac
	done
	bin=$(real "$(dir_of "$self")")
	case $bin in
	*/.bin) if [ -f "${bin%/.bin}/.ken" ]; then printf '%s\n' "${bin%/.bin}"; fi ;;
	esac
}

# Sets SCOPE, the root ken acts on, and TOP, the outermost root reached from it only through
# .repos/ folders, whose .repos/ holds every checkout (PRD decision 20). Both are real paths.
find_root() {
	if [ -n "${KEN_ROOT-}" ]; then
		dir=$KEN_ROOT from=KEN_ROOT
	else
		dir=$(pwd -P) from="the nearest .ken above the current folder"
		while [ -n "$dir" ] && [ ! -f "$dir/.ken" ]; do dir=${dir%/*}; done
		if [ -z "$dir" ]; then dir=$(script_root) from="the root this ken lives in, $0"; fi
		if [ -z "$dir" ]; then dir=$HOME/ken from="the default, ~/ken"; fi
	fi
	if [ ! -d "$dir" ]; then
		if [ -e "$dir" ]; then why='is not a folder'; else why='does not exist'; fi
		die "the ken root $dir (from $from) $why, and every ken command acts on a root." \
			"Run \`ken init $(q "$dir")\` to make one there, cd into a folder holding .ken," \
			"or set KEN_ROOT to a root."
	fi
	SCOPE=$(real "$dir")
	TOP=$SCOPE
	# a root reached through .repos/ is a checkout there: <up>/.repos/<host>/<owner>/<folder>
	while :; do
		case $TOP in
		*/.repos/*/*/*) up=${TOP%/.repos/*/*/*} ;;
		*) break ;;
		esac
		case ${TOP#"$up/.repos/"} in */*/*/*) break ;; esac
		if [ ! -f "$up/.ken" ]; then break; fi
		TOP=$up
	done
}

# --- keys and branches

# Whether $1 is a repo key: <host>/<owner>/<repo>, lowercase, each part [a-z0-9._-], neither
# . nor .. (PRD decision 2).
is_key() {
	case /$1/ in */./* | */../*) return 1 ;; esac
	case $1 in
	*[!a-z0-9._/-]* | */*/*/*) return 1 ;;
	?*/?*/?*) return 0 ;;
	*) return 1 ;;
	esac
}

# Sets KEY and URL from a key or a git URL (https, ssh or scp-style [user@]host:path). A URL
# is kept as given, for git, and loses its .git in the key; a key alone clones from
# https://<key>.git.
# shellcheck disable=SC2034 # URL is read by the commands that clone
parse_key() {
	KEY=$(lower "$1") URL=$1
	case $KEY in
	*"$nl"*) KEY= ;;
	[a-z]*://*)
		KEY=$(printf '%s\n' "$KEY" | sed -E -e 's#^[a-z][a-z0-9+.-]*://([^/]*@)?([^/:@]*)(:[0-9]*)?/#\2/#' -e 's#\.git$##')
		;;
	*:*) KEY=$(printf '%s\n' "$KEY" | sed -E -e 's#^([^/:]*@)?([^@:/]+):#\2/#' -e 's#\.git$##') ;;
	*) URL=https://$KEY.git ;;
	esac
	if ! is_key "$KEY"; then
		die "$(q "$(redact "$1")") is not a repo key or git URL, so it names no folder under .repos/." \
			"A key is <host>/<owner>/<repo> with one slash between each part, e.g. github.com/acme/join-web;" \
			"a URL is https://github.com/acme/join-web.git, ssh://git@github.com/acme/join-web.git" \
			"or git@github.com:acme/join-web.git. GitLab subgroups (an owner with slashes) are not supported."
	fi
}

# The folder of branch $1's worktree beside the clone, .repos/<key>.<folder>: / as -.
# Call as f=$(branch_folder "$b") || exit 1.
branch_folder() {
	case $1 in
	@ | *@\{*) checked= ;;
	*) checked=$(git check-ref-format --branch "$1" 2>/dev/null) || checked= ;;
	esac
	if [ "$checked" != "$1" ] || [ -z "$1" ]; then
		die "$(q "$(redact "$1")") is not a branch name git accepts (git check-ref-format --branch)," \
			"so no worktree can hold it. A branch name has no empty part between slashes, no part that" \
			"starts with . or ends in .lock, no .., @{, space, control character or any of ~^:?*[\\," \
			"does not start with - or end with ., and is not HEAD or @. Pick one such as feat/login."
	fi
	printf '%s\n' "$1" | tr / -
}

# --- the index: .repos/index, stanzas (docs/files.md, "Stanzas" and "Rules for both")

# One pass over an index, line by line so every other line is kept byte for byte and an error
# names its line; a stanza is a run of lines up to a blank one, comments inside it kept. It
# validates the whole file, failing at the first line it cannot read, and in I_MODE:
#   stanza  prints the stanza of repo I_KEY, its comments left out (nothing when none)
#   field   prints the value of field I_FIELD of repo I_KEY
#   list    prints "<key><tab>I_KEY<tab>I_FIELD<tab><desc>" for every repo, a tab in desc as a
#           space: I_KEY labels the root that lists it and I_FIELD names it, for ken repos
#   set     prints the file with I_LIST, <name>=<value> lines, set in I_KEY's stanza: a line
#           replaced, or appended at the stanza's end, or a new stanza at the end of the file
# Its input is passed through ENVIRON, as awk -v would expand the backslashes in a value.
INDEX_AWK='
function trim(s) {
	sub(/^[ \t]+/, "", s)
	sub(/[ \t]+$/, "", s)
	return s
}
function fail(what) {
	printf "ken: %s line %d, `%s`, %s, so ken cannot read the index. Fix that line, then rerun.\n", ENVIRON["I_FILE"], NR, $0, what | "cat 1>&2"
	bad = 1
	exit
}
function finish() {
	if (mode == "list" && rk != "") print rk "\t" key "\t" ENVIRON["I_FIELD"] "\t" d
	if (mode == "set" && here)
		for (i = 1; i <= n; i++)
			if (!(names[i] in done)) print names[i] ": " value[names[i]]
	open = here = 0
}
BEGIN {
	mode = ENVIRON["I_MODE"]
	key = ENVIRON["I_KEY"]
	w = mode == "set"
	k = split(ENVIRON["I_LIST"], list, "\n")
	for (i = 1; i <= k; i++) {
		if (list[i] == "") continue
		eq = index(list[i], "=")
		f = substr(list[i], 1, eq - 1)
		if (!(f in value)) names[++n] = f
		value[f] = substr(list[i], eq + 1)
	}
}
/^[ \t]*$/ {
	if (open) finish()
	blank = 1
	if (w) print
	next
}
{ blank = 0 }
/^#/ {
	if (w) print
	next
}
{
	c = index($0, ": ")
	f = c ? substr($0, 1, c - 1) : ""
	v = trim(substr($0, c + 2))
	if (!open) {
		ok = f == "repo" && v ~ /^[a-z0-9._-]+\/[a-z0-9._-]+\/[a-z0-9._-]+$/
		ok = ok || f == "owner" && v ~ /^[a-z0-9._-]+\/[a-z0-9._-]+$/
		if (!ok || ("/" v "/") ~ /\/\.\.?\//)
			fail("opens a stanza, which takes `repo: <host>/<owner>/<repo>` or `owner: <host>/<owner>`, lowercase, as its first line")
		if ((f, v) in first)
			fail("repeats the key of the stanza at line " first[f, v] "; a key has one stanza per file, so merge the two")
		first[f, v] = open = NR
		here = mode != "list" && f == "repo" && v == key
		rk = f == "repo" ? v : ""
		d = ""
		found = found || here
		split("", has)
	} else if (f !~ /^[A-Za-z0-9_-]+$/)
		fail("is not a field line `<name>: <value>`, a name of letters, digits, _ and -, a colon and a space, or the stanza lacks the blank line that ends it")
	else if (f in has)
		fail("names " f " a second time in the stanza at line " open "; a field appears once per stanza, so delete one")
	else if (f == "desc" && v == "")
		fail("is an empty desc; a desc says what the repo is, so write one or delete the line")
	has[f] = 1
	if (mode == "list" && f == "desc") {
		d = v
		gsub(/\t/, " ", d)
	}
	if (!here) {
		if (w) print
	} else if (mode == "stanza") print
	else if (mode == "field" && f == ENVIRON["I_FIELD"]) print v
	else if (mode == "set" && (f in value)) {
		print f ": " value[f]
		done[f] = 1
	} else if (w) print
}
END {
	if (bad) exit 1
	if (open) finish()
	if (mode == "set" && !found) {
		if (NR && !blank) print ""
		print "repo: " key
		for (i = 1; i <= n; i++) print names[i] ": " value[names[i]]
	}
}'

# Runs the index pass in mode $1 over the index file $2 (missing reads as empty), for repo key
# $3, with the field or list $4. A file it cannot read stops it: call as x=$(index_read ...) || exit 1.
index_read() {
	src=$2
	if [ -e "$src" ] && [ ! -f "$src" ]; then
		die "$src is not a file, so ken cannot read or write the index there." \
			"Move it aside, e.g. \`mv $(q "$src") $(q "$src.old")\`, then rerun."
	fi
	if [ ! -f "$src" ]; then src=/dev/null; fi
	I_MODE=$1 I_FILE=$2 I_KEY=${3-} I_FIELD=${4-} I_LIST=${4-} awk "$INDEX_AWK" "$src"
}

# Rewrites the index file $2 by the pass in mode $1, set: written beside it and
# renamed over, so a reader never sees half of it, and nothing written when it cannot be read.
# Writers take turns: the lock is $2.lock, a symlink to the holder's PID that ln -s makes in one
# step, so each write reads the index as the last one left it. Only its holder removes it: a
# lock whose holder is gone is refused, since removing it could race a writer taking it anew.
index_write() {
	mkdir -p "$(dir_of "$2")"
	lock=$2.lock
	# checked before each ln -s, which would make its link inside a folder in the way
	while :; do
		if [ ! -L "$lock" ] && ! absent "$lock"; then
			die "$lock is in the way of the lock on $2, a symlink to its writer's PID, so no write" \
				"could take turns there. Move it aside, e.g. \`mv $(q "$lock") $(q "$lock.old")\`, then rerun."
		fi
		if ln -s "$$" "$lock" 2>/dev/null; then break; fi
		if absent "$lock"; then
			if made=$(ln -s "$$" "$lock" 2>&1); then break; fi
			if absent "$lock"; then die "could not take the lock $lock: $made. Fix that, then rerun."; fi
		fi
		holder=$(readlink "$lock" 2>/dev/null) || continue
		if kill -0 "$holder" 2>/dev/null; then
			sleep 1
		elif [ "$(readlink "$lock" 2>/dev/null)" = "$holder" ]; then
			die "$lock is the lock on $2, left by process $holder, which ended before releasing it," \
				"so no write waiting on it would ever start. Check that no ken is running, then run" \
				"\`rm $(q "$lock")\` and rerun."
		fi
	done
	tmp=$2.tmp.$$
	if ! (index_read "$@") >"$tmp"; then
		rm -f "$tmp" "$lock"
		exit 1
	fi
	mv -f "$tmp" "$2"
	rm -f "$lock"
}

# --- layers: the layer.<name>=<key> lines of a root's .ken (docs/files.md)

# Prints the layers root $1's .ken lists, "<name><tab><key>" in file order, a name repeated
# read as its last line. A line it cannot read stops it: call as x=$(layer_lines "$r") || exit 1.
layer_lines() {
	found=''
	if [ -f "$1/.ken" ]; then
		while read -r n && read -r line; do
			name=${line%%=*} key=${line#*=}
			name=${name#layer.}
			case $line in *=*) ;; *) key= ;; esac
			case $name in '' | *[!A-Za-z0-9_.-]*) key= ;; esac
			if ! is_key "$key"; then
				die "$1/.ken line $n, $(q "$(redact "$line")"), is not a layer line ken can read," \
					"so ken cannot tell which repo that layer is, nor where its commands and index are." \
					"It expects layer.<name>=<host>/<owner>/<repo>, lowercase, such as" \
					"layer.sales-atlas=github.com/acme/sales-atlas. Fix or delete that line."
			fi
			kept=''
			while IFS=$tab read -r was its; do
				if [ -n "$was" ] && [ "$was" != "$name" ]; then kept=$kept$nl$was$tab$its; fi
			done <<EOF
$found
EOF
			found=$kept$nl$name$tab$key
		done <<EOF
$(sed -n '/^layer\./{=;p;}' "$1/.ken")
EOF
	fi
	if [ -n "$found" ]; then printf '%s\n' "${found#"$nl"}"; fi
}

# Rewrites the scope's .ken without the lines of layer $1, then with the line $2 when set, every
# other line kept: written beside and renamed over (docs/files.md, "Rules for both").
ken_write() {
	tmp=$SCOPE/.ken.tmp.$$
	if ! awk -v p="layer.$1=" 'index($0, p) != 1' "$SCOPE/.ken" >"$tmp" || ! printf '%s' "${2:+$2$nl}" >>"$tmp"; then
		rm -f "$tmp"
		die "could not write $SCOPE/.ken (the reason is above), so it is unchanged. Fix that, then rerun."
	fi
	mv -f "$tmp" "$SCOPE/.ken"
}

# Prints "<section><tab><key>" for each layer reachable from root $1 and cloned at the top, in
# walk order: each layer, then its own (PRD decision 22), a cycle visited once; its section is
# the path of its link from $1, as atlas/handbook. An offline layer is left out with its
# layers, said on stderr when $2 is set. find_root has run. Call as x=$(reachable "$r") || exit 1.
reachable() {
	todo=$(layer_lines "$1") || exit 1
	seen=' '
	while [ -n "$todo" ]; do
		line=${todo%%"$nl"*}
		case $todo in *"$nl"*) todo=${todo#*"$nl"} ;; *) todo='' ;; esac
		section=${line%%"$tab"*} key=${line#*"$tab"}
		case $seen in *" $key "*) continue ;; esac
		seen="$seen$key "
		if [ -z "$line" ]; then continue; fi
		if [ ! -d "$TOP/.repos/$key" ]; then
			if [ -n "${2-}" ]; then
				printf 'ken: %s %s\n' "the layer $section, $key, is offline: it has no clone at $TOP/.repos/$key, so its" \
					"index and its layers' are left out. Run \`ken init $(q "$1")\` to clone it." >&2
			fi
			continue
		fi
		printf '%s\n' "$line"
		mine=$(layer_lines "$TOP/.repos/$key") || exit 1
		if [ -n "$mine" ]; then mine=$(printf '%s\n' "$mine" | sed "s|^|$section/|"); fi
		todo=$mine$nl$todo
	done
}

# The relative way up from a folder $1 levels below root $2 to the top: ../.. and one .. more
# for each part of $2 below the top. find_root has run.
up_to_top() {
	up=.. i=1 rest=${2#"$TOP"}
	while [ $i -lt "$1" ]; do up=$up/.. i=$((i + 1)); done
	while [ -n "$rest" ]; do up=$up/.. rest=${rest%/*}; done
	printf '%s\n' "$up"
}

# Whether a folder of the three above $1, up to .repos or .agents, is a link, said on stdout:
# reconcile neither makes nor removes anything under one, which would act elsewhere.
linked_above() {
	for above in "${1%/*}" "${1%/*/*}" "${1%/*/*/*}"; do
		if [ -L "$above" ]; then
			printf 'Left %s alone: %s is a link, so ken makes or removes nothing inside it.\n' "$1" "$above"
			return 0
		fi
	done
	return 1
}

# Links $1 to $2, relative, when nothing is at $1 and no folder above it is a link, and says so.
link_in() {
	if linked_above "$1" || ! absent "$1" || ! mkdir -p "${1%/*}" || ! ln -s "$2" "$1"; then return 1; fi
	printf 'Linked %s -> %s\n' "$1" "$2"
}

# Makes what is derived from .ken match it at the scope (PRD, "Reconcile", decisions 21, 22):
# walks the scope's layers, each followed by its own, a key visited once, cloning each missing
# one unattended at the top as get does; one that cannot be cloned is offline, said on stderr,
# and the walk goes on. Then links each layer's layers into its .repos/, excluded locally, and
# at the scope each reachable layer's owner AGENTS.md and each direct layer's skills where the
# scope has none, removing such links into what is no longer reachable. TRACK, when set, holds
# more paths for the git add it prints. find_root has run; it runs in a subshell, so call as
# reconcile || exit 1.
reconcile() (
	GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=
	GIT_HTTP_LOW_SPEED_LIMIT=${GIT_HTTP_LOW_SPEED_LIMIT:-1000} GIT_HTTP_LOW_SPEED_TIME=${GIT_HTTP_LOW_SPEED_TIME:-30}
	export GIT_TERMINAL_PROMPT GIT_ASKPASS GIT_HTTP_LOW_SPEED_LIMIT GIT_HTTP_LOW_SPEED_TIME
	# ssh takes an option's first value, so ours go right after the ssh word of the user's command
	ssh=${GIT_SSH_COMMAND:-$(git config --get core.sshCommand 2>/dev/null || :)}
	if [ -n "$ssh" ] || [ -z "${GIT_SSH-}" ]; then
		ssh_opts='-o BatchMode=yes -o ConnectTimeout=15 -o ServerAliveInterval=15 -o ServerAliveCountMax=4'
		ssh=${ssh:-ssh}
		GIT_SSH_COMMAND=$(printf '%s\n' "$ssh" |
			sed -E "s#(^|[[:space:]])(\"([^\"]*/)?ssh\"|'([^']*/)?ssh'|([^[:space:]\"']*/)?ssh)([[:space:]]|\$)#\\1\\2 $ssh_opts\\6#")
		if [ "$GIT_SSH_COMMAND" = "$ssh" ]; then GIT_SSH_COMMAND="$ssh $ssh_opts"; fi
		export GIT_SSH_COMMAND
	fi
	todo=$(layer_lines "$SCOPE") || exit 1
	direct=" $(printf '%s\n' "$todo" | cut -f2 | tr '\n' ' ')" seen=' ' walked=' '
	while [ -n "$todo" ]; do
		line=${todo%%"$nl"*}
		case $todo in *"$nl"*) todo=${todo#*"$nl"} ;; *) todo='' ;; esac
		name=${line%%"$tab"*} key=${line#*"$tab"}
		if [ -z "$line" ]; then continue; fi
		case $seen in *" $key "*) continue ;; esac
		seen="$seen$key "
		clone=$TOP/.repos/$key
		# only a real clone counts as there; anything else is get's to refuse, naming the mv aside
		if [ "$(real "$clone" 2>/dev/null)" = "$clone" ] &&
			[ "$(git -C "$clone" rev-parse --absolute-git-dir 2>/dev/null)" = "$clone/.git" ]; then
			printf 'Layer %s: %s is cloned already, at %s; left as it is, no fetch.\n' "$name" "$key" "$clone"
		elif err=$( (KEN_ROOT=$SCOPE && cmd_get "$key") 2>&1 >/dev/null); then
			printf 'Layer %s: cloned %s at %s.\n' "$name" "$key" "$clone"
			if [ -n "$err" ]; then printf '%s\n' "$err" >&2; fi
		else
			why="it could not be cloned, so its pages, index, commands and skills are left out and its own"
			why="$why layers are unknown; the rest is installed. Once it can be cloned, run"
			printf 'ken: layer %s, %s, is offline on this machine: %s `ken init %s` again. %s\n' \
				"$name" "$key" "$why" "$(q "$SCOPE")" "${err#ken: }" >&2
			continue
		fi
		walked="$walked$key "
		mine=$(layer_lines "$clone") || exit 1
		if [ -n "$mine" ]; then todo=$(printf '%s\n' "$mine" | sed "s|^|$name/|")$nl$todo; fi
	done
	# each layer's tracked link <name> -> .repos/<key> resolves through a link to the hoisted clone
	for root in "$SCOPE" $walked; do
		case $root in /*) ;; *) root=$TOP/.repos/$root ;; esac
		if [ "$root" = "$TOP" ]; then continue; fi
		up=$(up_to_top 3 "$root")
		exclude=$(git -C "$root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)/info/exclude ||
			exclude=
		for key in $(layer_lines "$root" | cut -f2); do
			link_in "$root/.repos/$key" "$up/.repos/$key" || :
			if [ -n "$exclude" ] && ! grep -qxF "/.repos/$key" "$exclude" 2>/dev/null; then
				mkdir -p "${exclude%/*}"
				if [ -s "$exclude" ] && [ -n "$(tail -c 1 "$exclude")" ]; then printf '\n' >>"$exclude"; fi
				printf '/.repos/%s\n' "$key" >>"$exclude"
			fi
		done
	done
	# at the scope: links into what is no longer reachable go first, so a new layer can take their place
	up3=$(up_to_top 3 "$SCOPE") up2=$(up_to_top 2 "$SCOPE") track=${TRACK-} skilled=' '
	for key in $walked; do
		case $direct in *" $key "*) skilled="$skilled$key " ;; esac
	done
	for at in "$SCOPE"/.repos/*/*/AGENTS.md "$SCOPE"/.agents/skills/*; do
		if [ ! -L "$at" ] || linked_above "$at"; then continue; fi
		to=$(readlink "$at")
		case $at in
		*/.agents/skills/*) up=$up2 keep=$skilled why='a direct layer cloned here, whose skills alone are linked' ;;
		*) up=$up3 keep=$walked why='reachable from here' ;;
		esac
		case $to in "$up/.repos/"*) ;; *) continue ;; esac
		key=$(printf '%s\n' "${to#"$up/.repos/"}" | cut -d/ -f1-3)
		case $keep in *" $key "*) continue ;; esac
		rm -f "$at"
		printf 'Removed %s, a link into %s, which is no longer %s.\n' "$at" "$key" "$why"
		track="$track $(q "${at#"$SCOPE/"}")"
	done
	for key in $walked; do
		for at in "$TOP/.repos/$key"/.repos/*/*/AGENTS.md; do
			owner=${at#"$TOP/.repos/$key/.repos/"} && owner=${owner%/AGENTS.md}
			if [ -f "$at" ] && link_in "$SCOPE/.repos/$owner/AGENTS.md" "$up3/.repos/$key/.repos/$owner/AGENTS.md"; then
				track="$track $(q ".repos/$owner/AGENTS.md")"
			fi
		done
		case $skilled in *" $key "*) ;; *) continue ;; esac
		for at in "$TOP/.repos/$key"/.agents/skills/*; do
			if [ ! -e "$at" ]; then continue; fi
			if link_in "$SCOPE/.agents/skills/${at##*/}" "$up2/.repos/$key/.agents/skills/${at##*/}"; then
				track="$track $(q ".agents/skills/${at##*/}")"
			fi
		done
	done
	if [ -n "$track" ]; then
		printf 'Track the changes at %s with `git -C %s add -A --%s`.\n' "$SCOPE" "$(q "$SCOPE")" "$track"
	fi
)

# --- builtins: each one's help, then what it runs

# Sets usage, summary, details and examples for the builtin $1; fails for any other name.
