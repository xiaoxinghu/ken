indent() { printf '%s\n' "$2" | sed "s/^/$1/"; }

# What `ken help <name>` and `ken <name> --help` print; about has run.
full_help() {
	printf 'ken %s\n\n%s\n' "$usage" "$summary"
	if [ -n "$details" ]; then printf '\n%s\n' "$details"; fi
	printf '\nExamples:\n'
	indent '  ' "$examples"
}

cmd_init() {
	if [ $# -gt 1 ]; then
		die "ken init takes one folder, got $# arguments. Quote a path with spaces;" \
			'run e.g. `ken init ~/ken`.'
	fi
	case ${1-} in -*)
		die "ken init does not take $(q "$1"): it takes one folder, default the current one." \
			'Run `ken init --help`.'
		;;
	esac
	# the real path of the folder, which may not exist yet
	dir=$(real_path "${1:-.}") || exit 1
	# a root inside another only as a checkout in its .repos/, as find_root walks to the top
	cur=$dir
	while :; do
		up=${cur%/*}
		while [ -n "$up" ] && [ ! -f "$up/.ken" ]; do up=${up%/*}; done
		if [ -z "$up" ]; then break; fi
		case ${cur#"$up/.repos/"} in
		/* | */*/*/*) ;;
		?*/?*/?*)
			cur=$up
			continue
			;;
		esac
		die "$dir is inside the root $up but is not a checkout in its .repos/, so a root there would" \
			"be a workspace hidden in $up's knowledge base. Make it a section of $up, with no .ken;" \
			"share a root into $up with \`ken layer add <key>\` run there; or make a root outside $up," \
			'e.g. `ken init ~/other`.'
	done
	if ! absent "$dir/.ken" && [ ! -f "$dir/.ken" ]; then
		die "$dir/.ken is there but is not a file, and only a .ken file makes a folder a root, so" \
			"ken would never find $dir as one. Move it aside, then run \`ken init $(q "$dir")\` again."
	fi
	if ! mkdir -p -- "$dir/.repos" "$dir/.bin"; then
		die "could not make $dir/.repos and $dir/.bin (the reason is above), so $dir cannot be a root." \
			"Fix that or pick another folder, then run \`ken init $(q "$dir")\` again."
	fi
	dir=$(real "$dir") made=
	if absent "$dir/.ken"; then
		printf '%s\n' '# ken settings: <key>=<value> lines, the first segment of a key naming its tool.' \
			'# The format is docs/files.md in github.com/xiaoxinghu/ken.' >"$dir/.ken"
		made="$made .ken"
	fi
	if absent "$dir/.repos/index"; then
		printf '%s\n' "# .repos/index: what each repo is. Whether it exists is the remote's business." \
			>"$dir/.repos/index"
		made="$made .repos/index"
	fi
	if absent "$dir/.bin/ken"; then
		cp -- "$0" "$dir/.bin/ken"
		chmod +x "$dir/.bin/ken"
		made="$made .bin/ken"
	fi
	ignore=$dir/.gitignore
	for rule in '.repos/*/*/*/' .env; do
		if [ -f "$ignore" ] && sed 's/[[:space:]]*$//' "$ignore" | grep -qxF -e "$rule"; then continue; fi
		case $made in *" .gitignore"*) ;; *) made="$made .gitignore" ;; esac
		# a last line without its newline gets one, so the rule is a line of its own
		if [ -s "$ignore" ] && [ -n "$(tail -c 1 "$ignore")" ]; then printf '\n' >>"$ignore"; fi
		printf '%s\n' "$rule" >>"$ignore"
	done
	if [ -n "$made" ]; then
		printf '%s is a root. Made or added to:\n' "$dir"
		for file in $made; do printf '  %s\n' "$file"; done
		printf 'Track them with `git -C %s add%s`, after `git -C %s init` if it is not a repository.\n' \
			"$(q "$dir")" "$made" "$(q "$dir")"
	else
		printf '%s is a root already with every file ken owns: nothing was created.\n' "$dir"
	fi
	(KEN_ROOT=$dir && find_root && reconcile) || exit 1
	here=$(find_root 2>/dev/null && printf '%s\n' "$SCOPE") || here=
	if [ "$here" != "$dir" ]; then
		printf '%s\n' "ken run from here acts on ${here:-no root}, not $dir; inside $dir it finds it by" \
			'itself. To point ken at it from anywhere, link its kernel onto PATH (used outside any' \
			'root when KEN_ROOT is unset), or set KEN_ROOT:' \
			"  ln -s $(q "$dir/.bin/ken") ~/.local/bin/ken" \
			"  export KEN_ROOT=$(q "$dir")"
	fi
}

cmd_path() {
	case ${1-} in
	root)
		if [ $# -ne 1 ]; then die 'ken path root takes no arguments. Run `ken path root`.'; fi
		find_root
		printf '%s\n' "$SCOPE"
		;;
	code)
		if [ $# -lt 2 ] || [ $# -gt 3 ]; then
			die "ken path code takes <key> [<branch>], got $(($# - 1)) arguments." \
				'Run e.g. `ken path code github.com/acme/join-web feat/login`.'
		fi
		parse_key "$2"
		folder=
		if [ $# -eq 3 ]; then folder=.$(branch_folder "$3") || exit 1; fi
		find_root
		printf '%s\n' "$TOP/.repos/$KEY$folder"
		;;
	*:*)
		if [ $# -ne 1 ]; then
			die "ken path takes one reference, got $(q "$(redact "$*")"). Quote a path with spaces." \
				'Run `ken path --help` for the forms.'
		fi
		parse_key "${1%%:*}"
		rest=${1#*:} rel=${rest%%#*} depth=0
		set -f
		IFS=/
		for part in $rel; do
			case $part in
			..) depth=$((depth - 1)) ;;
			'' | .) ;;
			*) depth=$((depth + 1)) ;;
			esac
			if [ $depth -lt 0 ]; then break; fi
		done
		unset IFS
		set +f
		if [ $depth -lt 0 ]; then
			die "$(q "$(redact "$1")") points outside its repo: the path after the colon is relative to" \
				"the repo's root and cannot climb out of it. Write it as $KEY:<path>[#<symbol>]."
		fi
		find_root
		clone=$TOP/.repos/$KEY
		if [ -d "$clone" ]; then
			printf '%s\n' "$clone${rel:+/$rel}"
		else
			printf 'https://%s.git\n' "$KEY"
			printf 'ken: %s is not cloned here, so %s has no local path; printed its URL instead. %s\n' \
				"$KEY" "$(redact "${rel:-its root}")" \
				"Run \`ken get $KEY\` to clone it, then \`ken path $(q "$(redact "$1")")\` again." >&2
		fi
		;;
	*)
		die "ken path does not take $(q "$(redact "${1-}")"): it takes root, code <key> [<branch>]," \
			'or a code reference <key>:<path>[#<symbol>]. Run `ken path --help` for what each prints.'
		;;
	esac
}

cmd_which() {
	if [ $# -gt 1 ]; then
		die "ken which takes one path, got $#: quote a path with spaces." 'Run e.g. `ken which .`.'
	fi
	find_root
	at=$(real_path "${1:-.}") || exit 1
	nowhere="$at is in the ken root $TOP but in no checkout, so it has no key: a checkout is"
	nowhere="$nowhere a folder $TOP/.repos/<host>/<owner>/<repo>, or <repo>.<branch> beside it."
	nowhere="$nowhere Run \`ken path code <key> [<branch>]\` for the folder of one."
	case $at/ in
	"$TOP"/.repos/*/*/*/) rest=${at#"$TOP"/.repos/} ;;
	"$TOP"/*) die "$nowhere" ;;
	*)
		die "$at is outside the top root $TOP, whose .repos/ holds every checkout, so it has no key." \
			"Run \`ken which\` again from inside the root that holds it, or with KEN_ROOT set to it."
		;;
	esac
	host=${rest%%/*} rest=${rest#*/}
	owner=${rest%%/*} rest=${rest#*/}
	folder=${rest%%/*}
	dir=$TOP/.repos/$host/$owner/$folder
	if [ -e "$dir" ] && [ ! -d "$dir" ]; then die "$nowhere"; fi
	# its shape: <repo>.<x> beside a clone <repo>, a .git folder, is its worktree; the folder
	# name of a worktree holds a branch, so only the clone's name is a key
	repo=$folder kind=clone try=$folder
	while [ "${try%.*}" != "$try" ]; do
		try=${try%.*}
		if [ -n "$try" ] && [ -d "${dir%/*}/$try/.git" ]; then
			repo=$try kind=worktree
			break
		fi
	done
	if [ ! -e "$dir" ]; then
		parse_key "$host/$owner/$repo"
		printf '%s %s\n' "$KEY" "$kind"
		return
	fi
	if [ ! -e "$dir/.git" ]; then
		parse_key "$host/$owner/$repo"
		get="ken get $KEY"
		if [ $kind = worktree ]; then get="$get -b <branch>"; fi
		die "$dir is where a checkout belongs, but it has no .git, so it is no checkout and has no" \
			"branch. Look inside; if nothing there is needed, remove it and run \`$get\`."
	fi
	dirs=$(git -C "$dir" rev-parse --path-format=absolute --git-dir --git-common-dir) ||
		die "git cannot read the checkout $dir (above), so ken cannot tell its key or branch." \
			"Run \`git -C $(q "$dir") status\` to see what is wrong."
	branch=$(git -C "$dir" branch --show-current) || exit 1
	if [ "${dirs%%"$nl"*}" = "${dirs#*"$nl"}" ]; then
		parse_key "$host/$owner/$folder"
		printf '%s clone%s\n' "$KEY" "${branch:+ $branch}"
		return
	fi
	# a worktree's key is its clone's, wherever the worktree's folder is
	clone=$(real "${dirs#*"$nl"}") || exit 1
	clone=${clone%/*}
	key=${clone#"$TOP/.repos/"}
	if [ "$key" != "$clone" ] && is_key "$key"; then
		printf '%s worktree%s\n' "$key" "${branch:+ $branch}"
		return
	fi
	die "$dir is a worktree of $clone, a clone outside $TOP/.repos/<host>/<owner>/<repo>, so it" \
		"has no key, and a worktree in .repos/ must belong to a clone there. Move it beside its clone:" \
		"\`git -C $(q "$clone") worktree move $(q "$dir") $(q "${clone%/*}/$folder")\`."
}

# Sets worktree.useRelativePaths in the repo $1 when it is unset.
relative_paths() {
	git -C "$1" config --get worktree.useRelativePaths >/dev/null ||
		git -C "$1" config worktree.useRelativePaths true
}

# The -b half of get: prints the worktree of $branch beside $clone, $clone$folder, made when
# missing (PRD decision 2), or the clone for the default branch. cmd_get has run up to it.
get_worktree() {
	# the full ref, as --short turns main into heads/main when a tag is named main too
	if ! def=$(git -C "$clone" symbolic-ref -q HEAD); then
		name=$(git -C "$clone" symbolic-ref -q --short refs/remotes/origin/HEAD) || name=origin/main
		die "$clone has a detached HEAD, so it names no default branch, and the clone holds the default" \
			"branch for every worktree to start from. Run \`git -C $(q "$clone") switch ${name#origin/}\`" \
			"(or the default branch's name), then \`$again\` again."
	fi
	def=${def#refs/heads/}
	exists=
	if [ "$branch" = "$def" ] || git -C "$clone" show-ref -q --verify "refs/heads/$branch"; then exists=1; fi
	case $exists$opts in 1*' --from '*)
		die "$branch exists in $clone already, so it is not made again from --from $(q "$from_ref")." \
			"Run \`ken get $KEY -b $(q "$branch")\` for its worktree, or pick a new branch name."
		;;
	esac
	if [ "$branch" = "$def" ]; then
		printf '%s\n' "$clone"
		return
	fi
	# the worktree holding a branch, asked of git one ref at a time, so a path is never split
	# and only for a branch that exists: refs/heads/feat would match refs/heads/feat/x too
	held=''
	if [ -n "$exists" ]; then held=$(git -C "$clone" for-each-ref --format='%(worktreepath)' "refs/heads/$branch"); fi
	if [ -n "$held" ] && [ -d "$held" ]; then
		printf '%s\n' "$held"
		return
	elif [ -n "$held" ]; then
		die "$branch is checked out in the worktree $held, whose folder is gone, and git checks a branch" \
			"out in one worktree at a time. Run \`git -C $(q "$clone") worktree prune\`, then \`$again\` again."
	fi
	wt=$clone$folder
	hit=$(for at in "${clone%/*}"/* "${clone%/*}"/.*; do printf '%s\n' "${at##*/}"; done |
		grep -ixF -e "${wt##*/}" | head -n 1)
	if [ -n "$hit" ]; then
		hit=${clone%/*}/$hit
		its=$(git -C "$hit" branch --show-current 2>/dev/null) || its=
		if [ -n "$its" ] && [ "$(git -C "$clone" for-each-ref --format='%(worktreepath)' "refs/heads/$its")" != "$hit" ]; then its=; fi
		what="$hit is in the way"
		if [ "$hit" != "$wt" ]; then what="$hit differs only by case from it, one folder on a case-insensitive disk"; fi
		if [ -n "$its" ]; then what="$what, a worktree of $clone holding the branch $its"; fi
		die "the worktree of $branch belongs at $wt, but $what, so ken makes nothing. Pick another" \
			"branch name, or move it aside, e.g. \`mv $(q "$hit") ~/${hit##*/}.aside\`, then \`$again\` again."
	fi
	made_branch=
	if [ -z "$exists" ]; then
		start=HEAD
		case $opts in *' --from '*) start=$from_ref ;; esac
		if ! base=$(git -C "$clone" rev-parse -q --verify --end-of-options "$start^{commit}"); then
			if [ "$start" != HEAD ]; then
				die "$(q "$from_ref") is no commit in $clone, so $branch cannot start from it. Run" \
					"\`git -C $(q "$clone") fetch --tags\` if it is on the remote, then \`$again\` again."
			fi
			die "the default branch $def of $clone has no commit yet, so there is nothing to start $branch" \
				"from. Commit to $def there first, or run \`ken get $KEY -b $(q "$branch") --from <ref>\`."
		fi
		# the lock: of two gets of one new branch, one makes it
		if ! err=$(git -C "$clone" branch "$branch" "$base" 2>&1); then
			if git -C "$clone" show-ref -q --verify "refs/heads/$branch"; then
				die "$branch was made in $clone just now, by another \`ken get\`, so this one made nothing." \
					"Run \`ken get $KEY -b $(q "$branch")\`, without --from, for its worktree."
			fi
			die "could not make the branch $branch in $clone. git said: $err${nl}Fix that, then run \`$again\` again."
		fi
		made_branch=1
	fi
	made_dir=
	if err=$(mkdir -- "$wt" 2>&1); then made_dir=1; fi
	if [ -z "$made_dir" ] || ! err=$(git -C "$clone" worktree add -q -- "$wt" "$branch" 2>&1); then
		undone=
		if [ -n "$made_dir" ]; then rmdir -- "$wt" 2>/dev/null || :; fi
		if [ -n "$made_dir" ] && absent "$wt"; then undone=" Removed the folder $wt again."; fi
		if [ -n "$made_dir" ] && ! absent "$wt"; then undone=" Left $wt, which is not empty: look inside."; fi
		# a folder made there since the checks is another get's claim, about to check $branch out
		if [ -z "$made_dir" ] && [ -d "$wt" ] && [ ! -L "$wt" ]; then
			die "$wt was made just now, by another \`ken get\` adding the worktree of $branch, so this" \
				"one stops and leaves $branch to it. Run \`ken get $KEY -b $(q "$branch")\` for its worktree."
		elif [ -n "$made_branch" ] && git -C "$clone" branch -q -D "$branch" 2>/dev/null; then
			undone="$undone Deleted the branch $branch again."
		elif [ -n "$made_branch" ]; then
			undone="$undone Left the branch $branch, which a worktree holds: \`git -C $(q "$clone") worktree list\`."
		fi
		die "could not make the worktree of $branch at $wt: $err${nl}So $branch has no worktree.$undone" \
			"Fix that, then run \`$again\` again."
	fi
	# a worktree of a root is a root: reconciled, saying so on stderr, as stdout is the path alone
	if [ -f "$wt/.ken" ]; then (KEN_ROOT=$wt && find_root && reconcile) >&2 || exit 1; fi
	printf '%s\n' "$wt"
}

cmd_get() {
	asked='' branch='' from_ref='' opts=''
	while [ $# -gt 0 ]; do
		case $1 in
		-b | --from)
			if [ $# -lt 2 ]; then die "ken get $1 needs a value. Run e.g. \`ken get <key> -b feat/login\`."; fi
			if [ "$1" = -b ]; then branch=$2; else from_ref=$2; fi
			opts="$opts $1 $(q "$(redact "$2")")"
			shift 2
			;;
		*)
			if [ -n "$asked" ] || [ "${1#-}" != "$1" ]; then
				die "ken get takes one repo key or git URL, then -b <branch> [--from <ref>], not" \
					"$(q "$(redact "$1")") as well. Run e.g. \`ken get github.com/acme/join-web -b feat/login\`."
			fi
			asked=$1
			shift
			;;
		esac
	done
	case $opts in
	'' | *' -b '*) ;;
	*) die "ken get --from names what a new branch starts from, so it needs -b <branch>. Run e.g. \`ken get <key> -b fix/x --from v1.2\`." ;;
	esac
	if [ -z "$asked" ]; then die 'ken get needs a repo key or git URL. Run e.g. `ken get github.com/acme/join-web`.'; fi
	parse_key "$asked"
	# a bad branch name is refused before anything is touched
	folder=
	case $opts in *' -b '*) folder=.$(branch_folder "$branch") || exit 1 ;; esac
	again="ken get $KEY$opts"
	version=$(git --version 2>/dev/null) ||
		die "git is not on PATH, and ken get clones with it. Install git 2.48 or newer" \
			"(e.g. \`brew install git\`), then run \`$again\` again."
	major=${version#git version } minor=${version#git version *.}
	major=${major%%[!0-9]*} minor=${minor%%[!0-9]*}
	if [ "${major:-0}" -lt 2 ] || { [ "$major" -eq 2 ] && [ "${minor:-0}" -lt 48 ]; }; then
		die "$version is too old: ken needs git 2.48 or newer, for worktree.useRelativePaths, which" \
			"lets a whole <owner>/ folder move. Install it (e.g. \`brew install git\`), check" \
			"\`git --version\`, then run \`$again\` again."
	fi
	find_root
	filter=--filter=blob:none
	case $(sed -n '/^clone\.blobless=/{s/^[^=]*=[[:space:]]*//;s/[[:space:]]*$//;p;}' "$SCOPE/.ken" 2>/dev/null | tail -n 1) in
	'' | true) ;;
	false) filter= ;;
	*) die "$SCOPE/.ken sets clone.blobless to neither true nor false, so ken cannot tell how to clone." \
		"Fix that line to clone.blobless=false or true, then run \`$again\` again." ;;
	esac
	clone=$TOP/.repos/$KEY parent=$TOP/.repos/${KEY%/*}
	for at in "$TOP/.repos" "${parent%/*}" "$parent"; do
		if [ -L "$at" ]; then
			to=$(readlink "$at")
			case $to in /*) ;; *) to=$(dir_of "$at")/$to ;; esac
			die "$at is a symlink to $to, so a clone under it would be outside the top root $TOP," \
				"whose .repos/ holds every checkout so that context cascades along its real path." \
				"Put the folder in its place, \`rm $(q "$at") && mv $(q "$to") $(q "$at")\`, or start an" \
				"empty one, \`rm $(q "$at")\`; then run \`$again\` again."
		fi
	done
	# every get marks itself before the claim, so one that loses the mkdir waits while the
	# winner lives: its clone is whole once the mark is gone
	mark=$parent/.${KEY##*/}.ken-get.$$
	if ! mkdir -p -- "$mark"; then
		die "could not make $parent (the reason is above), so $KEY has no folder to be cloned into." \
			"Fix that, then run \`$again\` again."
	fi
	trap 'rmdir "$mark" 2>/dev/null || :' EXIT
	if made=$(mkdir -- "$clone" 2>&1); then
		trap 'rm -rf "$clone"; exit 1' INT TERM HUP
		if ! err=$(git clone -q ${filter:+"$filter"} -- "$URL" "$clone" 2>&1); then
			rm -rf "$clone"
			hint=
			case $asked in *:*) ;; *)
				hint="A key alone clones https://$KEY.git; for another remote pass its URL, e.g."
				hint="$hint \`ken get git@${KEY%%/*}:${KEY#*/}.git\`. "
				;;
			esac
			die "could not clone $(redact "$URL") into $clone, so it was removed again. git said:" \
				"$(redact "$err")$nl${hint}Fix the cause, then run \`ken get $(q "$(redact "$asked")")$opts\` again."
		fi
		trap - INT TERM HUP
	else
		rmdir "$mark"
		if absent "$clone"; then
			die "could not make $clone: $made. Fix that, then run \`$again\` again."
		fi
		busy=1
		while [ -n "$busy" ]; do
			busy=
			for at in "$parent/.${KEY##*/}.ken-get."*; do
				pid=${at##*.}
				case $pid in '' | *[!0-9]*) continue ;; esac
				if kill -0 "$pid" 2>/dev/null; then busy=1; fi
			done
			if [ -n "$busy" ]; then sleep 1; fi
		done
	fi
	what=
	if [ -L "$clone" ]; then
		what="a symlink to $(readlink "$clone")"
	elif absent "$clone"; then
		die "$clone is gone: another \`ken get $KEY\` was cloning into it and failed, saying why in" \
			"its own output. Run \`$again\` again to clone it here."
	elif [ ! -d "$clone" ]; then
		what='a file'
	elif absent "$clone/.git"; then
		what='a folder with no .git'
	elif [ -L "$clone/.git" ] || [ ! -d "$clone/.git" ]; then
		what='a checkout whose .git is not a folder: a worktree, or a repo kept elsewhere'
	elif [ "$(git -C "$clone" rev-parse --absolute-git-dir 2>/dev/null)" != "$clone/.git" ]; then
		what='a folder whose .git git does not take as its repo'
	fi
	if [ -n "$what" ]; then
		init=
		if [ "$what" = 'a folder with no .git' ]; then
			init=" To make this folder the repo instead, run \`git init $(q "$clone")\` then \`$again\`."
		fi
		die "$clone is where the clone of $KEY belongs, but it is $what, so ken neither uses nor" \
			"replaces it. Move it aside, e.g. \`mv $(q "$clone") ~/${KEY##*/}.aside\`, then run" \
			"\`$again\` again.$init"
	fi
	# another get of an existing repo may hold git's config lock, setting the same: wait, recheck
	if ! relative_paths "$clone" 2>/dev/null && ! { sleep 1 && relative_paths "$clone"; }; then
		die "could not set worktree.useRelativePaths in $clone (the reason is above), which lets" \
			"its <owner>/ folder move. Run \`git -C $(q "$clone") config worktree.useRelativePaths true\`," \
			"then \`$again\` again."
	fi
	git -C "$clone" worktree repair >&2
	file=$SCOPE/.repos/index
	listed=$(index_read stanza "$file" "$KEY") || exit 1
	if [ -z "$listed" ]; then
		layers=$(reachable "$SCOPE") || exit 1
		for layer in $(printf '%s\n' "$layers" | cut -f 2); do
			listed=$(index_read stanza "$TOP/.repos/$layer/.repos/index" "$KEY") || exit 1
			if [ -n "$listed" ]; then break; fi
		done
	fi
	if [ -z "$listed" ]; then
		index_write set "$file" "$KEY" ''
		printf 'ken: %s %s\n' "registered $KEY in $file with no desc, and a desc is what lets an agent" \
			"choose a repo before cloning it. Run \`ken index set $KEY desc=\"...\"\` with what it is, in a line." >&2
	fi
	if [ -z "$folder" ]; then
		printf '%s\n' "$clone"
		return
	fi
	get_worktree
}

cmd_repos() {
	porcelain=
	for arg; do
		if [ "$arg" != --porcelain ]; then
			die "ken repos takes only --porcelain, not $(q "$(redact "$arg")"). Run \`ken repos --help\`."
		fi
		porcelain=1
	done
	find_root
	layers=$(reachable "$SCOPE" say) || exit 1
	# the merged index, "<key><tab><listed by><tab><. or the layer's key><tab><desc>", no path
	# in it to hold a tab or a newline, and the source apart from the label, as a layer may be
	# named root; then at the top each clone, a folder whose .git is one; the first line of a key wins
	all=$(index_read list "$SCOPE/.repos/index" root .) || exit 1
	while IFS=$tab read -r section layer; do
		if [ -z "$layer" ]; then continue; fi
		mine=$(index_read list "$TOP/.repos/$layer/.repos/index" "$section" "$layer") || exit 1
		all=$all$nl$mine
	done <<EOF
$layers
EOF
	if [ "$SCOPE" = "$TOP" ]; then
		# every name at each level, hidden ones too: a key part may start with a dot
		for host in "$TOP"/.repos/* "$TOP"/.repos/.[!.]* "$TOP"/.repos/..?*; do
			for owner in "$host"/* "$host"/.[!.]* "$host"/..?*; do
				for at in "$owner"/*/.git "$owner"/.[!.]*/.git "$owner"/..?*/.git; do
					key=${at%/.git}
					key=${key#"$TOP/.repos/"}
					if [ -d "$at" ] && is_key "$key"; then all=$all$nl$key; fi
				done
			done
		done
	fi
	all=$(printf '%s\n' "$all" | awk -F "$tab" 'NF && !seen[$1]++' | LC_ALL=C sort -t "$tab" -k 1,1)
	if [ -z "$all" ]; then
		disk=
		if [ "$SCOPE" = "$TOP" ]; then disk=", and $TOP/.repos holds no clone"; fi
		printf 'ken: %s %s\n' "no index of $SCOPE or of its layers lists a repo$disk, so there is nothing to list." \
			"Run \`ken get <key>\` to clone a repo and list it, or \`ken index set <key> desc=\"...\"\` to list one uncloned." >&2
		return
	fi
	# each key a row, of fields that only trail empty, since read joins tabs as it joins spaces
	while IFS=$tab read -r key by from desc; do
		clone=$TOP/.repos/$key cloned=false on='' trees='' strays=''
		if [ -z "$by" ]; then
			strays="$strays$nl  stray: no index lists it, so nothing says what it is and only this disk knows it."
			strays="$strays Run \`ken index set $key desc=\"...\"\`."
		elif [ -z "$desc" ]; then
			cd=
			if [ "$from" != . ]; then cd="cd $(q "$TOP/.repos/$from") && "; fi
			strays="$strays$nl  stray: no desc, and a desc is what lets an agent choose a repo before cloning it."
			strays="$strays Run \`${cd}ken index set $key desc=\"...\"\`."
		fi
		if [ -d "$clone/.git" ]; then
			cloned=true
			# one record per worktree, the clone first, a line per attribute; a newline in a path as
			# \001, shown as ? and given back for the path the commands name
			list=$(git -C "$clone" worktree list --porcelain -z | tr '\n\000' '\001\n')
			first=1 path='' branch='' gone=''
			while IFS= read -r line; do
				case $line in
				'worktree '*) path=${line#worktree } ;;
				'branch refs/heads/'*) branch=${line#branch refs/heads/} ;;
				prunable*) gone=1 ;;
				'')
					if [ -n "$first" ]; then
						first='' on=$branch
					elif [ -n "$path" ] && [ -z "$gone" ]; then
						shown=$(printf '%s\n' "$path" | tr '\001' '?')
						path=$(printf '%s\n' "$path" | tr '\001' '\n')
						trees="$trees$nl  worktree ${branch:-(detached)}  $shown"
						at=$(real "$path" 2>/dev/null) || at=$path
						want=$clone.$(printf '%s\n' "$branch" | tr / -)
						if [ -n "$branch" ] && [ "$at" != "$want" ]; then
							strays="$strays$nl  stray: the worktree of $branch is at $shown, not $want, where \`ken get -b\`"
							strays="$strays and \`ken path code\` look for it. Run \`git -C $(q "$clone") worktree move $(q "$at") $(q "$want")\`."
						fi
					fi
					path='' branch='' gone=''
					;;
				esac
			done <<EOF
$list

EOF
			# the full ref, as --short turns origin/main into remotes/origin/main beside a tag origin/main
			def=$(git -C "$clone" symbolic-ref -q refs/remotes/origin/HEAD) || def=''
			def=${def#refs/remotes/origin/}
			if [ -n "$def" ] && [ "$on" != "$def" ]; then
				was='a detached HEAD' fix="git -C $(q "$clone") switch $(q "$def")"
				if [ -n "$on" ]; then was="the branch $on" fix="$fix\`, then \`ken get $key -b $(q "$on")"; fi
				strays="$strays$nl  stray: the clone has $was checked out, not its default branch $def, which"
				strays="$strays every \`ken get -b\` starts from. Run \`$fix\`."
			fi
		fi
		if [ -n "$porcelain" ]; then
			printf '%s\t%s\t%s\t%s\t%s\n' "$key" "$desc" "$by" "$cloned" "$on"
			continue
		fi
		state='not cloned'
		if [ $cloned = true ]; then state="cloned on ${on:-a detached HEAD}"; fi
		printf '%s  listed by %s, %s\n' "$key" "${by:-no index}" "$state"
		if [ -n "$desc" ]; then printf '  %s\n' "$desc"; fi
		trees=$trees$strays
		if [ -n "$trees" ]; then printf '%s\n' "${trees#"$nl"}"; fi
	done <<EOF
$all
EOF
}

cmd_index() {
	if [ "${1-}" != set ]; then
		die "ken index takes set, then a repo key, got $(q "$(redact "${1-}")")." \
			'Run e.g. `ken index set github.com/acme/join-web desc="Front end for the join funnel."`,' \
			'or `ken index --help` for the form. To remove a field or an entry, edit .repos/index.'
	fi
	if [ $# -lt 2 ]; then die 'ken index set needs a repo key. Run `ken index --help` for the form.'; fi
	parse_key "$2"
	shift 2
	find_root
	file=$SCOPE/.repos/index
	if [ $# -eq 0 ]; then
		die "ken index set $KEY needs at least one <field>=<value> to write." \
			"Run e.g. \`ken index set $KEY desc=\"What it is, in a line.\"\`."
	fi
	list='' set=''
	for arg; do
		field=${arg%%=*} value=${arg#*=}
		case $arg in *=*) ;; *) field='' ;; esac
		case $field in '' | *[!A-Za-z0-9_-]* | repo)
			die "$(q "$(redact "$arg")") is not a <field>=<value> ken index set can write: a field" \
				"name is letters, digits, _ and -, and repo is the entry's key line, not a field." \
				"Run e.g. \`ken index set $KEY kind=frontend\`."
			;;
		esac
		case $value in *"$nl"*)
			die "the value of $field has a newline, and an index value is one line." \
				"Write longer text in a page, then run \`ken index set $KEY doc=<path>\`."
			;;
		esac
		case $value in *[![:space:]]*) ;; *)
			die "the value of $field is empty, and an empty field says nothing. Run" \
				"\`ken index set $KEY $field=<value>\` with a value, or delete its line from $file to remove it."
			;;
		esac
		list=$list$field=$value$nl
		case ", $set, " in *", $field, "*) ;; *) set="${set:+$set, }$field" ;; esac
	done
	entry=$(index_read stanza "$file" "$KEY") || exit 1
	index_write set "$file" "$KEY" "$list"
	if [ -n "$entry" ]; then entry='the entry'; else entry='a new entry'; fi
	printf 'Set %s in %s for %s, in %s.\n' "$set" "$entry" "$KEY" "$file"
}

cmd_layer() {
	sub=${1-}
	if [ $# -gt 0 ]; then shift; fi
	case $sub in
	add) layer_add "$@" ;;
	remove) layer_remove "$@" ;;
	*)
		die "ken layer takes add or remove, got $(q "$(redact "$sub")"). Run e.g." \
			'`ken layer add github.com/acme/sales-atlas`, or `ken layer --help` for the forms.'
		;;
	esac
}

# Every refusal comes before anything is written; then each step checks before it acts, so a
# rerun finishes an add that failed halfway: the link made but no .ken line yet.
layer_add() {
	asked='' name=''
	while [ $# -gt 0 ]; do
		if [ "$1" = --as ] && [ $# -ge 2 ]; then
			name=$2
			shift 2
			continue
		fi
		if [ -n "$asked" ] || [ "${1#-}" != "$1" ]; then
			die "ken layer add takes one repo key or git URL, then --as <name>, not $(q "$(redact "$1")")." \
				'Run e.g. `ken layer add github.com/acme/sales-atlas --as atlas`.'
		fi
		asked=$1
		shift
	done
	if [ -z "$asked" ]; then die 'ken layer add needs a repo key or git URL. Run e.g. `ken layer add github.com/acme/sales-atlas`.'; fi
	parse_key "$asked"
	name=${name:-${KEY##*/}} again="ken layer add $(q "$(redact "$asked")")"
	find_root
	other="Run \`$again --as <other-name>\`"
	case $name in . | .. | *[!A-Za-z0-9_.-]*)
		die "$(q "$name") is not a layer name, which is a folder at $SCOPE and the key layer.<name> in" \
			"its .ken, so letters, digits, ., _ and -, neither . nor ..; $other."
		;;
	esac
	reserved=' .repos .bin .ken .agents .claude .codex .pi .envrc agents.md claude.md log.md readme.md '
	case $reserved in *" $(lower "$name") "*)
		die "$name is a reserved name at a root, in any case, the kernel's, a harness's or the front" \
			"page's, so it cannot be a layer's section. $other."
		;;
	esac
	layers=$(layer_lines "$SCOPE") || exit 1
	while IFS=$tab read -r was its; do
		if [ "$its" = "$KEY" ]; then
			die "$KEY is a layer of $SCOPE already, as $was, and one clone is one section. Run" \
				"\`ken init $(q "$SCOPE")\` to finish installing it, or \`ken layer remove $was\` first to rename it."
		elif [ "$was" = "$name" ]; then
			die "$name is the layer of $its in $SCOPE/.ken already, and a name is one section." \
				"$other, or \`ken layer remove $name\` first."
		fi
	done <<EOF
$layers
EOF
	at=$SCOPE/$name
	if ! absent "$at" && [ "$(readlink "$at" 2>/dev/null)" != ".repos/$KEY" ]; then
		die "$at is there already, so $name cannot be the layer's section, a link ken makes over" \
			"nothing. $other."
	fi
	(cmd_get "$asked" >/dev/null) ||
		die "so $name is not added, and nothing but what get said was written. Fix that, then run \`$again\` again."
	if absent "$at"; then
		ln -s ".repos/$KEY" "$at"
		printf 'Linked %s -> .repos/%s\n' "$at" "$KEY"
	fi
	ken_write "$name" "layer.$name=$KEY"
	printf 'Added layer.%s=%s to %s/.ken.\n' "$name" "$KEY" "$SCOPE"
	TRACK=" $(q "$name") .ken"
	if [ -f "$SCOPE/.repos/index" ]; then TRACK="$TRACK .repos/index"; fi
	reconcile || exit 1
	printf '%s\n' "Add a line for $name under ## Layers in $SCOPE/README.md, what it is and who keeps" \
		'it: the front page lists every layer, ken edits no page, and `ken lint` checks it.'
}

layer_remove() {
	if [ $# -ne 1 ]; then die "ken layer remove takes one layer name, got $#. Run e.g. \`ken layer remove sales-atlas\`."; fi
	find_root
	layers=$(layer_lines "$SCOPE") || exit 1
	key=''
	while IFS=$tab read -r was its; do
		if [ -n "$was" ] && [ "$was" = "$1" ]; then key=$its; fi
	done <<EOF
$layers
EOF
	if [ -z "$key" ]; then
		names=$(printf '%s\n' "$layers" | cut -f1 | paste -s -d ' ' -)
		printf '%s is not a layer of %s, so there is nothing to remove. Its layers: %s.\n' \
			"$(q "$1")" "$SCOPE" "${names:-none}"
		return
	fi
	ken_write "$1" ''
	printf 'Removed layer.%s=%s from %s/.ken.\n' "$1" "$key" "$SCOPE"
	TRACK=' .ken' at=$SCOPE/$1
	if [ "$(readlink "$at" 2>/dev/null)" = ".repos/$key" ]; then
		rm -f "$at"
		printf 'Removed the link %s.\n' "$at"
		TRACK="$TRACK $(q "$1")"
	elif ! absent "$at"; then
		printf 'Left %s alone: it is not the link to .repos/%s ken made.\n' "$at" "$key"
	fi
	# in a layer, the link to the hoisted clone; reconcile makes it again if another line needs it
	at=$SCOPE/.repos/$key
	if [ "$SCOPE" != "$TOP" ] && [ "$(readlink "$at" 2>/dev/null)" = "$(up_to_top 3 "$SCOPE")/.repos/$key" ]; then
		rm -f "$at"
		printf 'Removed the link %s.\n' "$at"
	fi
	reconcile || exit 1
	printf '%s\n' "The clone of $key stays at $TOP/.repos/$key, with its worktrees and any work in them." \
		"When no root on this machine uses it, delete it with \`rm -rf \"\$(ken path code $key)\"\`."
}

cmd_help() {
	if [ $# -gt 1 ]; then die 'ken help takes one command. Run e.g. `ken help path`.'; fi
	if [ $# -eq 1 ]; then
		if about "$1"; then
			full_help
			return
		fi
		shown=$(q "$(redact "$1")")
		die "$shown is not a builtin, so ken help has no page for it. If it is an external" \
			"command, run \`ken $shown --help\`; run \`ken help\` for every command."
	fi
	cat <<'EOF'
ken: the kernel of a ken root, a workspace that is a knowledge base with every checkout
inside it at .repos/<host>/<owner>/<repo>, and each branch beside it at <repo>.<branch>.

Usage: ken <command> [<args>]

Commands:
EOF
	for name in $BUILTINS; do
		about "$name"
		printf '  %s\n' "$usage"
		indent '      ' "$summary$nl$examples"
	done
	cat <<'EOF'
  <name> [<args>]
      Run the first executable ken-<name> in the scope's .bin/, each direct layer's .bin/
      in .ken order, then PATH, with KEN_ROOT set to the scope. A builtin always wins.

EOF
	if err=$({ find_root && places; } 2>&1); then
		find_root
		places
		externals
		printf '\nHere the scope is %s and the top is %s.\n' "$SCOPE" "$TOP"
	else
		printf 'External commands: none listed, because %s\n' "${err#ken: }"
	fi
	cat <<'EOF'
The scope is KEN_ROOT, else the nearest folder holding .ken above the current one, else the
root this ken lives in (<root>/.bin/ken, through a symlink on PATH), else ~/ken.
Run `ken <command> --help` for its forms.
EOF
}

# --- external commands (PRD decision 10)

# Sets PLACES: where ken-<name> is looked for, in order, one "<folder><tab><from>" per line:
# the scope's .bin/, each direct layer's in .ken order, then PATH. find_root has run.
places() {
	PLACES="$SCOPE/.bin${tab}the scope"
	layers=$(layer_lines "$SCOPE") || exit 1
	while IFS=$tab read -r layer key; do
		if [ -n "$layer" ]; then PLACES=$PLACES$nl$TOP/.repos/$key/.bin${tab}layer\ $layer; fi
	done <<EOF
$layers
EOF
	set -f
	IFS=:
	# an empty PATH entry is the current folder, as in any shell; the : added keeps a last one
	search=$PATH:
	for entry in $search; do PLACES=$PLACES$nl${entry:-.}${tab}PATH; done
	unset IFS
	set +f
}

# Prints the external commands `ken <name>` runs, by where each was found. places has run.
externals() {
	seen=" $BUILTINS " found=
	while IFS=$tab read -r dir from; do
		names=
		for file in "$dir"/ken-*; do
			name=${file##*/ken-}
			if [ -n "$name" ] && [ -f "$file" ] && [ -x "$file" ]; then
				case $seen in
				*" $name "*) ;;
				*) seen="$seen$name " names="$names, $name" ;;
				esac
			fi
		done
		if [ -n "$names" ]; then found="$found$nl  $from, $dir: ${names#, }"; fi
	done <<EOF
$PLACES
EOF
	if [ -n "$found" ]; then
		printf 'External commands, run as `ken <name>`, by where their ken-<name> was found:%s\n' "$found"
	else
		printf 'External commands: none found. Add one as an executable ken-<name> in %s.\n' "$SCOPE/.bin"
	fi
}

# Runs the first executable ken-$1 found with the rest of the arguments, by exec, so signals and
# the exit code are its own, with KEN_ROOT the real scope.
dispatch() {
	name=$1
	shift
	find_root
	places
	run='' plain='' looked=''
	while IFS=$tab read -r dir from; do
		looked="$looked$nl  $dir  ($from)"
		file=$dir/ken-$name
		case $name in '' | */*) continue ;; esac
		if [ -f "$file" ] && [ -x "$file" ]; then
			run=$file
			break
		fi
		if [ -f "$file" ] && [ -z "$plain" ]; then plain=$file; fi
	done <<EOF
$PLACES
EOF
	if [ -n "$run" ]; then
		KEN_ROOT=$SCOPE
		export KEN_ROOT
		exec "$run" "$@"
	fi
	shown=$(q "$(redact "$name")")
	if [ -n "$plain" ]; then
		die "$plain would run as \`ken $shown\`, but it is not executable." \
			"Run \`chmod +x $(q "$plain")\`, then \`ken $shown\` again."
	fi
	die "$shown is not a ken command, and no executable ken-<name> by that name was found." \
		"Looked in, in order:$looked${nl}Run \`ken help\` for the builtins and the external commands" \
		"found, or add an executable ken-<name> in $SCOPE/.bin."
}

# --- main

command=${1-help}
if [ $# -gt 0 ]; then shift; fi
case $command in -h | --help) command=help ;; esac
if about "$command"; then
	for arg; do
		case $arg in -h | --help)
			full_help
			exit 0
			;;
		esac
	done
	"cmd_$command" "$@"
else
	dispatch "$command" "$@"
fi
