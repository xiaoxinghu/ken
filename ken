#!/bin/sh
# ken: the kernel of a ken root. One POSIX sh file; its only dependency is git.
# The spec is docs/prd.md, "The kernel"; the files it reads are docs/files.md.
#
# Hazards, designed around everywhere below:
# - An exit inside $(...) ends only the subshell, so a function that can die is called as
#   x=$(f) || exit 1, or sets variables in this shell instead of printing.
# - A && B || C is not if-then-else: C runs when B fails too. Write if.
# - sed -i, stat and readlink -f differ between macOS and GNU, so they are not used.
# - Paths pass through git with -z.
# - CDPATH makes cd go elsewhere and print, so it is unset.
# - sh has no local: a function's variables are global, so each is named apart from its
#   callers'.
# shellcheck disable=SC2016 # backquotes in messages are commands to run, not expansions
set -eu
unset CDPATH

nl='
'
tab=$(printf '\t')
BUILTINS='init path which get index help'

# --- prelude

die() {
	printf 'ken: %s\n' "$*" >&2
	exit 1
}

# $1 as one shell word: as is when nothing in it is special to a shell, else single-quoted.
q() {
	case $1 in
	'' | *[!A-Za-z0-9_./@%+=:,-]*) printf "'%s'" "$(printf '%s\n' "$1" | sed "s/'/'\\\\''/g")" ;;
	*) printf '%s' "$1" ;;
	esac
}

# The real path of the folder $1: symlinks resolved, and on a case-insensitive disk the
# case as stored, so roots compare as real paths (PRD decision 15).
real() { (cd -P -- "$1" && pwd -P); }

# The real path of $1, which need not exist: walked a part at a time, each symlink followed
# where it is met, to a file or to nothing too (40 at most, so a cycle ends), so a .. always
# climbs a real folder; then the longest existing folder is made real, for the case stored on
# a case-insensitive disk. Call as p=$(real_path "$1") || exit 1.
real_path() {
	case $1 in /*) todo=$1 ;; *) todo=$(pwd -P)/$1 ;; esac
	head='' hops=0
	while [ -n "$todo" ]; do
		part=${todo%%/*}
		case $todo in */*) todo=${todo#*/} ;; *) todo='' ;; esac
		case $part in
		'' | .) ;;
		..) head=${head%/*} ;;
		*)
			if [ -L "$head/$part" ] && [ $hops -lt 40 ]; then
				hops=$((hops + 1))
				link=$(readlink "$head/$part")
				case $link in /*) head='' ;; esac
				todo=$link/$todo
			else
				head=$head/$part
			fi
			;;
		esac
	done
	rest=''
	while [ -n "$head" ] && [ ! -d "$head" ]; do rest=/${head##*/}$rest head=${head%/*}; done
	head=$(real "${head:-/}") || return 1
	head=${head%/}$rest
	printf '%s\n' "${head:-/}"
}

lower() { printf '%s\n' "$1" | tr '[:upper:]' '[:lower:]'; }

# $1 without the userinfo (user:token@) of any URL in it, so a message never shows a secret.
redact() {
	printf '%s\n' "$1" | sed -E \
		-e 's#([A-Za-z][A-Za-z0-9+.-]*://)[^/[:space:]]*@#\1#g' \
		-e 's#(^|[[:space:]])[^/:[:space:]]*@([^@:/[:space:]]+:)#\1\2#g'
}

# Whether nothing, not even a dangling link, is at $1.
absent() { [ ! -e "$1" ] && [ ! -L "$1" ]; }

dir_of() {
	case $1 in
	*/*) printf '%s\n' "${1%/*}" ;;
	*) printf '.\n' ;;
	esac
}

# --- the root

# The root this file lives in as <root>/.bin/ken, through any symlinks to it, else nothing.
script_root() {
	self=$0
	while [ -L "$self" ]; do
		link=$(readlink "$self")
		case $link in
		/*) self=$link ;;
		*) self=$(dir_of "$self")/$link ;;
		esac
	done
	bin=$(real "$(dir_of "$self")")
	case $bin in
	*/.bin) if [ -f "${bin%/.bin}/.ken" ]; then printf '%s\n' "${bin%/.bin}"; fi ;;
	esac
}

# Sets SCOPE, the root ken acts on, and TOP, the outermost root reached from it only through
# .repos/ folders, whose .repos/ holds every checkout (PRD decision 20). Both are real paths.
find_root() {
	if [ -n "${KEN_ROOT-}" ]; then
		dir=$KEN_ROOT from=KEN_ROOT
	else
		dir=$(pwd -P) from="the nearest .ken above the current folder"
		while [ -n "$dir" ] && [ ! -f "$dir/.ken" ]; do dir=${dir%/*}; done
		if [ -z "$dir" ]; then dir=$(script_root) from="the root this ken lives in, $0"; fi
		if [ -z "$dir" ]; then dir=$HOME/ken from="the default, ~/ken"; fi
	fi
	if [ ! -d "$dir" ]; then
		if [ -e "$dir" ]; then why='is not a folder'; else why='does not exist'; fi
		die "the ken root $dir (from $from) $why, and every ken command acts on a root." \
			"Run \`ken init $(q "$dir")\` to make one there, cd into a folder holding .ken," \
			"or set KEN_ROOT to a root."
	fi
	SCOPE=$(real "$dir")
	TOP=$SCOPE
	# a root reached through .repos/ is a checkout there: <up>/.repos/<host>/<owner>/<folder>
	while :; do
		case $TOP in
		*/.repos/*/*/*) up=${TOP%/.repos/*/*/*} ;;
		*) break ;;
		esac
		case ${TOP#"$up/.repos/"} in */*/*/*) break ;; esac
		if [ ! -f "$up/.ken" ]; then break; fi
		TOP=$up
	done
}

# --- keys and branches

# Whether $1 is a repo key: <host>/<owner>/<repo>, lowercase, each part [a-z0-9._-], neither
# . nor .. (PRD decision 2).
is_key() {
	case /$1/ in */./* | */../*) return 1 ;; esac
	case $1 in
	*[!a-z0-9._/-]* | */*/*/*) return 1 ;;
	?*/?*/?*) return 0 ;;
	*) return 1 ;;
	esac
}

# Sets KEY and URL from a key or a git URL (https, ssh or scp-style [user@]host:path). A URL
# is kept as given, for git, and loses its .git in the key; a key alone clones from
# https://<key>.git.
# shellcheck disable=SC2034 # URL is read by the commands that clone
parse_key() {
	KEY=$(lower "$1") URL=$1
	case $KEY in
	*"$nl"*) KEY= ;;
	[a-z]*://*)
		KEY=$(printf '%s\n' "$KEY" | sed -E -e 's#^[a-z][a-z0-9+.-]*://([^/]*@)?([^/:@]*)(:[0-9]*)?/#\2/#' -e 's#\.git$##')
		;;
	*:*) KEY=$(printf '%s\n' "$KEY" | sed -E -e 's#^([^/:]*@)?([^@:/]+):#\2/#' -e 's#\.git$##') ;;
	*) URL=https://$KEY.git ;;
	esac
	if ! is_key "$KEY"; then
		die "$(q "$(redact "$1")") is not a repo key or git URL, so it names no folder under .repos/." \
			"A key is <host>/<owner>/<repo> with one slash between each part, e.g. github.com/acme/join-web;" \
			"a URL is https://github.com/acme/join-web.git, ssh://git@github.com/acme/join-web.git" \
			"or git@github.com:acme/join-web.git. GitLab subgroups (an owner with slashes) are not supported."
	fi
}

# The folder of branch $1's worktree beside the clone, .repos/<key>.<folder>: / as -.
# Call as f=$(branch_folder "$b") || exit 1.
branch_folder() {
	case $1 in
	@ | *@\{*) checked= ;;
	*) checked=$(git check-ref-format --branch "$1" 2>/dev/null) || checked= ;;
	esac
	if [ "$checked" != "$1" ] || [ -z "$1" ]; then
		die "$(q "$(redact "$1")") is not a branch name git accepts (git check-ref-format --branch)," \
			"so no worktree can hold it. A branch name has no empty part between slashes, no part that" \
			"starts with . or ends in .lock, no .., @{, space, control character or any of ~^:?*[\\," \
			"does not start with - or end with ., and is not HEAD or @. Pick one such as feat/login."
	fi
	printf '%s\n' "$1" | tr / -
}

# --- the index: .repos/index, stanzas (docs/files.md, "Stanzas" and "Rules for both")

# One pass over an index, line by line so every other line is kept byte for byte and an error
# names its line; a stanza is a run of lines up to a blank one, comments inside it kept. It
# validates the whole file, failing at the first line it cannot read, and in I_MODE:
#   stanza  prints the stanza of repo I_KEY, its comments left out (nothing when none)
#   field   prints the value of field I_FIELD of repo I_KEY
#   keys    prints every repo key
#   set     prints the file with I_LIST, <name>=<value> lines, set in I_KEY's stanza: a line
#           replaced, or appended at the stanza's end, or a new stanza at the end of the file
#   unset   prints the file without the fields of I_KEY named in I_LIST, space-separated
#   drop    prints the file without I_KEY's stanza and the blank line after it
# Its input is passed through ENVIRON, as awk -v would expand the backslashes in a value.
INDEX_AWK='
function trim(s) {
	sub(/^[ \t]+/, "", s)
	sub(/[ \t]+$/, "", s)
	return s
}
function fail(what) {
	printf "ken: %s line %d, `%s`, %s, so ken cannot read the index. Fix that line, then rerun.\n", ENVIRON["I_FILE"], NR, $0, what | "cat 1>&2"
	bad = 1
	exit
}
function finish() {
	if (mode == "set" && here)
		for (i = 1; i <= n; i++)
			if (!(names[i] in done)) print names[i] ": " value[names[i]]
	open = here = 0
}
BEGIN {
	mode = ENVIRON["I_MODE"]
	key = ENVIRON["I_KEY"]
	w = mode == "set" || mode == "unset" || mode == "drop"
	k = split(ENVIRON["I_LIST"], list, mode == "set" ? "\n" : " ")
	for (i = 1; i <= k; i++) {
		if (list[i] == "") continue
		if (mode == "unset") {
			gone[list[i]] = 1
			continue
		}
		eq = index(list[i], "=")
		f = substr(list[i], 1, eq - 1)
		if (!(f in value)) names[++n] = f
		value[f] = substr(list[i], eq + 1)
	}
}
/^[ \t]*$/ {
	dropped = here && mode == "drop"
	if (open) finish()
	blank = 1
	if (w && !dropped) print
	next
}
{ blank = 0 }
/^#/ {
	if (w && !(here && mode == "drop")) print
	next
}
{
	c = index($0, ": ")
	f = c ? substr($0, 1, c - 1) : ""
	v = trim(substr($0, c + 2))
	if (!open) {
		ok = f == "repo" && v ~ /^[a-z0-9._-]+\/[a-z0-9._-]+\/[a-z0-9._-]+$/
		ok = ok || f == "owner" && v ~ /^[a-z0-9._-]+\/[a-z0-9._-]+$/
		if (!ok || ("/" v "/") ~ /\/\.\.?\//)
			fail("opens a stanza, which takes `repo: <host>/<owner>/<repo>` or `owner: <host>/<owner>`, lowercase, as its first line")
		if ((f, v) in first)
			fail("repeats the key of the stanza at line " first[f, v] "; a key has one stanza per file, so merge the two")
		first[f, v] = open = NR
		here = f == "repo" && v == key
		found = found || here
		split("", has)
	} else if (f !~ /^[A-Za-z0-9_-]+$/)
		fail("is not a field line `<name>: <value>`, a name of letters, digits, _ and -, a colon and a space, or the stanza lacks the blank line that ends it")
	else if (f in has)
		fail("names " f " a second time in the stanza at line " open "; a field appears once per stanza, so delete one")
	else if (f == "desc" && v == "")
		fail("is an empty desc; a desc says what the repo is, so write one or delete the line")
	has[f] = 1
	if (mode == "keys" && open == NR && f == "repo") print v
	if (!here) {
		if (w) print
	} else if (mode == "stanza") print
	else if (mode == "field" && f == ENVIRON["I_FIELD"]) print v
	else if (mode == "set" && (f in value)) {
		print f ": " value[f]
		done[f] = 1
	} else if (w && mode != "drop" && !(f in gone)) print
}
END {
	if (bad) exit 1
	if (open) finish()
	if (mode == "set" && !found) {
		if (NR && !blank) print ""
		print "repo: " key
		for (i = 1; i <= n; i++) print names[i] ": " value[names[i]]
	}
}'

# Runs the index pass in mode $1 over the index file $2 (missing reads as empty), for repo key
# $3, with the field or list $4. A file it cannot read stops it: call as x=$(index_read ...) || exit 1.
index_read() {
	src=$2
	if [ -e "$src" ] && [ ! -f "$src" ]; then
		die "$src is not a file, so ken cannot read or write the index there." \
			"Move it aside, e.g. \`mv $(q "$src") $(q "$src.old")\`, then rerun."
	fi
	if [ ! -f "$src" ]; then src=/dev/null; fi
	I_MODE=$1 I_FILE=$2 I_KEY=${3-} I_FIELD=${4-} I_LIST=${4-} awk "$INDEX_AWK" "$src"
}

# Rewrites the index file $2 by the pass in mode $1 (set, unset or drop): written beside it and
# renamed over, so a reader never sees half of it, and nothing written when it cannot be read.
index_write() {
	mkdir -p "$(dir_of "$2")"
	tmp=$2.tmp.$$
	if ! index_read "$@" >"$tmp"; then
		rm -f "$tmp"
		exit 1
	fi
	mv -f "$tmp" "$2"
}

# --- layers: the layer.<name>=<key> lines of a root's .ken (docs/files.md)

# Prints the layers root $1's .ken lists, "<name><tab><key>" in file order, a name repeated
# read as its last line. A line it cannot read stops it: call as x=$(layer_lines "$r") || exit 1.
layer_lines() {
	found=''
	if [ -f "$1/.ken" ]; then
		while read -r n && read -r line; do
			name=${line%%=*} key=${line#*=}
			name=${name#layer.}
			case $line in *=*) ;; *) key= ;; esac
			case $name in '' | *[!A-Za-z0-9_.-]*) key= ;; esac
			if ! is_key "$key"; then
				die "$1/.ken line $n, $(q "$(redact "$line")"), is not a layer line ken can read," \
					"so ken cannot tell which repo that layer is, nor where its commands and index are." \
					"It expects layer.<name>=<host>/<owner>/<repo>, lowercase, such as" \
					"layer.sales-atlas=github.com/acme/sales-atlas. Fix or delete that line."
			fi
			kept=''
			while IFS=$tab read -r was its; do
				if [ -n "$was" ] && [ "$was" != "$name" ]; then kept=$kept$nl$was$tab$its; fi
			done <<EOF
$found
EOF
			found=$kept$nl$name$tab$key
		done <<EOF
$(sed -n '/^layer\./{=;p;}' "$1/.ken")
EOF
	fi
	if [ -n "$found" ]; then printf '%s\n' "${found#"$nl"}"; fi
}

# Prints the key of each layer reachable from root $1 and cloned at the top, in walk order:
# each layer, then its own (PRD decision 22), a cycle visited once; an offline layer is left
# out with its layers. find_root has run. Call as x=$(reachable "$r") || exit 1.
reachable() {
	todo=$(layer_lines "$1") || exit 1
	seen=' '
	while [ -n "$todo" ]; do
		line=${todo%%"$nl"*}
		case $todo in *"$nl"*) todo=${todo#*"$nl"} ;; *) todo='' ;; esac
		key=${line#*"$tab"}
		case $seen in *" $key "*) continue ;; esac
		seen="$seen$key "
		if [ -z "$line" ] || [ ! -d "$TOP/.repos/$key" ]; then continue; fi
		printf '%s\n' "$key"
		mine=$(layer_lines "$TOP/.repos/$key") || exit 1
		todo=$mine$nl$todo
	done
}

# --- builtins: each one's help, then what it runs

# Sets usage, summary, details and examples for the builtin $1; fails for any other name.
about() {
	details=
	case $1 in
	init)
		usage='init [<dir>]'
		summary='Make <dir>, default the current folder, a root: only the files ken owns, never overwriting.'
		details='  .ken            settings, key=value lines; holding one is what makes a folder a root
  .repos/index    what each repo is, one stanza per repo, cloned or not
  .bin/ken        a copy of this ken, so the kernel travels with the root
  .gitignore      .repos/*/*/*/ (the checkouts) and .env, added to one that lacks them
No page, no AGENTS.md: those belong to a template. No git init. A <dir> inside another root
is refused unless it is a checkout, <root>/.repos/<host>/<owner>/<repo>.'
		examples='ken init ~/ken
git clone <root> ~/ken && ~/ken/.bin/ken init
cd "$(ken path code github.com/acme/atlas)" && ken init'
		;;
	path)
		usage='path root | code <key> [<branch>] | <key>:<path>[#<symbol>]'
		summary='Print a path, whether or not it exists. Nobody pastes absolute paths.'
		details='  root                     the scope: the nearest root, as a real path
  code <key> [<branch>]    the clone, <top>/.repos/<key>, or the worktree of <branch> beside
                           it, <top>/.repos/<key>.<branch> with / as -. <key> is
                           <host>/<owner>/<repo> or a git URL. The top is the outermost root
                           reached through .repos/ folders: it holds every checkout.
  <key>:<path>[#<symbol>]  a code reference: <clone>/<path> when the repo is cloned, the
                           symbol yours to find in the file. Not cloned: https://<key>.git,
                           and stderr says to run `ken get <key>`; exit 0.'
		examples='ken path root
ken path code github.com/acme/join-web
ken path code github.com/acme/join-web feat/login   # .../join-web.feat-login
cd "$(ken path code git@github.com:acme/join-web.git PROJ-123)"
ken path github.com/acme/join-web:src/join.ts#submit'
		;;
	which)
		usage='which [<path>]'
		summary='The reverse of `ken path code`: the key of the checkout a path is in, and its branch.'
		details='  <path>   default the current folder, compared as a real path against .repos/ in the
           top, so a path through a layer link resolves, and a layer is a checkout of
           the root above it. Prints `<key> <clone|worktree> <branch>`. A checkout is
           asked of git, a worktree keyed by its clone; a path not checked out yet is
           answered from its shape with no branch: <repo>.<x> beside a clone <repo> is
           its worktree. A detached HEAD prints no branch. Outside a checkout folder,
           .repos/<host>/<owner>/<folder>, it exits 1 saying so and what to run.'
		examples='ken which
ken which "$(ken path code github.com/acme/join-web feat/login)"   # github.com/acme/join-web worktree feat/login
ken which "$(ken path code github.com/acme/api)/src/x.ts"   # not cloned yet: github.com/acme/api clone'
		;;
	get)
		usage='get <url|key>'
		summary='Make a repo ready at the top and print its clone, <top>/.repos/<key>, the only thing on stdout.'
		details='  <url|key>   <host>/<owner>/<repo>, cloned from https://<key>.git, or a git URL.
Missing, the repo is cloned there: blobless, unless the scope'"'"'s .ken says
clone.blobless=false; a failed clone leaves no folder. A clone already there is used as
it is, no fetch; anything else there is refused untouched. Every time: the clone gets
worktree.useRelativePaths and `git worktree repair`, and when no index of the scope or of
its layers lists the key, an entry in the scope'"'"'s .repos/index. Needs git 2.48 or newer.'
		examples='ken get github.com/acme/join-web
ken get git@github.com:acme/join-web.git
cd "$(ken get github.com/acme/join-web)"'
		;;
	index)
		usage='index set <key> <field>=<value>... | unset <key> [<field>...]'
		summary="Write fields into the scope's index, .repos/index, or remove them or the entry."
		details='  set <key> <field>=<value>...  set each field of the entry, creating the file and the
                                entry when missing. A field name is letters, digits, _ and -;
                                a value is the rest of the argument as written, not empty, a
                                list its items separated by spaces: tags="sales join".
  unset <key> [<field>...]      remove the fields, or with none the whole entry. desc alone is
                                not removed: set it, or unset the entry.

Only that one stanza changes: every other line, comment and order is kept, and the file is
written beside and renamed over. For a layer'"'"'s index, cd into the layer first.'
		examples='ken index set github.com/acme/join-web desc="Front end for the join funnel." kind=frontend
ken index set github.com/acme/join-web tags="sales join" depends_on=join-api
ken index unset github.com/acme/join-web tags depends_on
ken index unset github.com/acme/join-web'
		;;
	help)
		usage='help [<command>]'
		summary='Print every command with examples, or one in full as `ken <command> --help` does.'
		examples='ken help
ken help path'
		;;
	*) return 1 ;;
	esac
}

indent() { printf '%s\n' "$2" | sed "s/^/$1/"; }

# What `ken help <name>` and `ken <name> --help` print; about has run.
full_help() {
	printf 'ken %s\n\n%s\n' "$usage" "$summary"
	if [ -n "$details" ]; then printf '\n%s\n' "$details"; fi
	printf '\nExamples:\n'
	indent '  ' "$examples"
}

cmd_init() {
	if [ $# -gt 1 ]; then
		die "ken init takes one folder, got $# arguments. Quote a path with spaces;" \
			'run e.g. `ken init ~/ken`.'
	fi
	case ${1-} in -*)
		die "ken init does not take $(q "$1"): it takes one folder, default the current one." \
			'Run `ken init --help`.'
		;;
	esac
	# the real path of the folder, which may not exist yet: its nearest existing folder made real
	want=${1:-.}
	case $want in /*) ;; *) want=$(pwd -P)/$want ;; esac
	want=${want%/} rest=
	while [ ! -d "${want:-/}" ]; do
		if [ "${want##*/}" = .. ]; then
			die "$(q "$1") climbs out of ${want%/*} with .., but that folder does not exist, so" \
				'ken cannot tell where the root would be, nor whether it is inside another root.' \
				'Write the path without .. after a missing folder, e.g. `ken init ~/ken`.'
		fi
		# a . or an empty part (//) names no folder, so it is no level of .repos/<host>/<owner>/<repo>
		case ${want##*/} in . | '') ;; *) rest=/${want##*/}$rest ;; esac
		want=${want%/*}
	done
	dir=$(real "${want:-/}")
	dir=${dir%/}$rest
	# a root inside another only as a checkout in its .repos/, as find_root walks to the top
	cur=$dir
	while :; do
		up=${cur%/*}
		while [ -n "$up" ] && [ ! -f "$up/.ken" ]; do up=${up%/*}; done
		if [ -z "$up" ]; then break; fi
		case ${cur#"$up/.repos/"} in
		/* | */*/*/*) ;;
		?*/?*/?*)
			cur=$up
			continue
			;;
		esac
		die "$dir is inside the root $up but is not a checkout in its .repos/, so a root there would" \
			"be a workspace hidden in $up's knowledge base. Make it a section of $up, with no .ken;" \
			"share a root into $up with \`ken layer add <key>\` run there; or make a root outside $up," \
			'e.g. `ken init ~/other`.'
	done
	if ! absent "$dir/.ken" && [ ! -f "$dir/.ken" ]; then
		die "$dir/.ken is there but is not a file, and only a .ken file makes a folder a root, so" \
			"ken would never find $dir as one. Move it aside, then run \`ken init $(q "$dir")\` again."
	fi
	if ! mkdir -p -- "$dir/.repos" "$dir/.bin"; then
		die "could not make $dir/.repos and $dir/.bin (the reason is above), so $dir cannot be a root." \
			"Fix that or pick another folder, then run \`ken init $(q "$dir")\` again."
	fi
	dir=$(real "$dir") made=
	if absent "$dir/.ken"; then
		printf '%s\n' '# ken settings: <key>=<value> lines, the first segment of a key naming its tool.' \
			'# The format is docs/files.md in github.com/xiaoxinghu/ken.' >"$dir/.ken"
		made="$made .ken"
	fi
	if absent "$dir/.repos/index"; then
		printf '%s\n' "# .repos/index: what each repo is. Whether it exists is the remote's business." \
			>"$dir/.repos/index"
		made="$made .repos/index"
	fi
	if absent "$dir/.bin/ken"; then
		cp -- "$0" "$dir/.bin/ken"
		chmod +x "$dir/.bin/ken"
		made="$made .bin/ken"
	fi
	ignore=$dir/.gitignore
	for rule in '.repos/*/*/*/' .env; do
		if [ -f "$ignore" ] && sed 's/[[:space:]]*$//' "$ignore" | grep -qxF -e "$rule"; then continue; fi
		case $made in *" .gitignore"*) ;; *) made="$made .gitignore" ;; esac
		# a last line without its newline gets one, so the rule is a line of its own
		if [ -s "$ignore" ] && [ -n "$(tail -c 1 "$ignore")" ]; then printf '\n' >>"$ignore"; fi
		printf '%s\n' "$rule" >>"$ignore"
	done
	if [ -n "$made" ]; then
		printf '%s is a root. Made or added to:\n' "$dir"
		for file in $made; do printf '  %s\n' "$file"; done
		printf 'Track them with `git -C %s add%s`, after `git -C %s init` if it is not a repository.\n' \
			"$(q "$dir")" "$made" "$(q "$dir")"
	else
		printf '%s is a root already with every file ken owns: nothing was created.\n' "$dir"
	fi
	# reconcile its layers here (PRD, "Reconcile") once ken has it
	here=$(find_root 2>/dev/null && printf '%s\n' "$SCOPE") || here=
	if [ "$here" != "$dir" ]; then
		printf '%s\n' "ken run from here acts on ${here:-no root}, not $dir; inside $dir it finds it by" \
			'itself. To point ken at it from anywhere, link its kernel onto PATH (used outside any' \
			'root when KEN_ROOT is unset), or set KEN_ROOT:' \
			"  ln -s $(q "$dir/.bin/ken") ~/.local/bin/ken" \
			"  export KEN_ROOT=$(q "$dir")"
	fi
}

cmd_path() {
	case ${1-} in
	root)
		if [ $# -ne 1 ]; then die 'ken path root takes no arguments. Run `ken path root`.'; fi
		find_root
		printf '%s\n' "$SCOPE"
		;;
	code)
		if [ $# -lt 2 ] || [ $# -gt 3 ]; then
			die "ken path code takes <key> [<branch>], got $(($# - 1)) arguments." \
				'Run e.g. `ken path code github.com/acme/join-web feat/login`.'
		fi
		parse_key "$2"
		folder=
		if [ $# -eq 3 ]; then folder=.$(branch_folder "$3") || exit 1; fi
		find_root
		printf '%s\n' "$TOP/.repos/$KEY$folder"
		;;
	*:*)
		if [ $# -ne 1 ]; then
			die "ken path takes one reference, got $(q "$(redact "$*")"). Quote a path with spaces." \
				'Run `ken path --help` for the forms.'
		fi
		parse_key "${1%%:*}"
		rest=${1#*:} rel=${rest%%#*} depth=0
		set -f
		IFS=/
		for part in $rel; do
			case $part in
			..) depth=$((depth - 1)) ;;
			'' | .) ;;
			*) depth=$((depth + 1)) ;;
			esac
			if [ $depth -lt 0 ]; then break; fi
		done
		unset IFS
		set +f
		if [ $depth -lt 0 ]; then
			die "$(q "$(redact "$1")") points outside its repo: the path after the colon is relative to" \
				"the repo's root and cannot climb out of it. Write it as $KEY:<path>[#<symbol>]."
		fi
		find_root
		clone=$TOP/.repos/$KEY
		if [ -d "$clone" ]; then
			printf '%s\n' "$clone${rel:+/$rel}"
		else
			printf 'https://%s.git\n' "$KEY"
			printf 'ken: %s is not cloned here, so %s has no local path; printed its URL instead. %s\n' \
				"$KEY" "$(redact "${rel:-its root}")" \
				"Run \`ken get $KEY\` to clone it, then \`ken path $(q "$(redact "$1")")\` again." >&2
		fi
		;;
	*)
		die "ken path does not take $(q "$(redact "${1-}")"): it takes root, code <key> [<branch>]," \
			'or a code reference <key>:<path>[#<symbol>]. Run `ken path --help` for what each prints.'
		;;
	esac
}

cmd_which() {
	if [ $# -gt 1 ]; then
		die "ken which takes one path, got $#: quote a path with spaces." 'Run e.g. `ken which .`.'
	fi
	find_root
	at=$(real_path "${1:-.}") || exit 1
	nowhere="$at is in the ken root $TOP but in no checkout, so it has no key: a checkout is"
	nowhere="$nowhere a folder $TOP/.repos/<host>/<owner>/<repo>, or <repo>.<branch> beside it."
	nowhere="$nowhere Run \`ken path code <key> [<branch>]\` for the folder of one."
	case $at/ in
	"$TOP"/.repos/*/*/*/) rest=${at#"$TOP"/.repos/} ;;
	"$TOP"/*) die "$nowhere" ;;
	*)
		die "$at is outside the top root $TOP, whose .repos/ holds every checkout, so it has no key." \
			"Run \`ken which\` again from inside the root that holds it, or with KEN_ROOT set to it."
		;;
	esac
	host=${rest%%/*} rest=${rest#*/}
	owner=${rest%%/*} rest=${rest#*/}
	folder=${rest%%/*}
	dir=$TOP/.repos/$host/$owner/$folder
	if [ -e "$dir" ] && [ ! -d "$dir" ]; then die "$nowhere"; fi
	# its shape: <repo>.<x> beside a clone <repo>, a .git folder, is its worktree; the folder
	# name of a worktree holds a branch, so only the clone's name is a key
	repo=$folder kind=clone try=$folder
	while [ "${try%.*}" != "$try" ]; do
		try=${try%.*}
		if [ -n "$try" ] && [ -d "${dir%/*}/$try/.git" ]; then
			repo=$try kind=worktree
			break
		fi
	done
	if [ ! -e "$dir" ]; then
		parse_key "$host/$owner/$repo"
		printf '%s %s\n' "$KEY" "$kind"
		return
	fi
	if [ ! -e "$dir/.git" ]; then
		parse_key "$host/$owner/$repo"
		get="ken get $KEY"
		if [ $kind = worktree ]; then get="$get -b <branch>"; fi
		die "$dir is where a checkout belongs, but it has no .git, so it is no checkout and has no" \
			"branch. Look inside; if nothing there is needed, remove it and run \`$get\`."
	fi
	dirs=$(git -C "$dir" rev-parse --path-format=absolute --git-dir --git-common-dir) ||
		die "git cannot read the checkout $dir (above), so ken cannot tell its key or branch." \
			"Run \`git -C $(q "$dir") status\` to see what is wrong."
	branch=$(git -C "$dir" branch --show-current) || exit 1
	if [ "${dirs%%"$nl"*}" = "${dirs#*"$nl"}" ]; then
		parse_key "$host/$owner/$folder"
		printf '%s clone%s\n' "$KEY" "${branch:+ $branch}"
		return
	fi
	# a worktree's key is its clone's, wherever the worktree's folder is
	clone=$(real "${dirs#*"$nl"}") || exit 1
	clone=${clone%/*}
	key=${clone#"$TOP/.repos/"}
	if [ "$key" != "$clone" ] && is_key "$key"; then
		printf '%s worktree%s\n' "$key" "${branch:+ $branch}"
		return
	fi
	die "$dir is a worktree of $clone, a clone outside $TOP/.repos/<host>/<owner>/<repo>, so it" \
		"has no key, and a worktree in .repos/ must belong to a clone there. Move it beside its clone:" \
		"\`git -C $(q "$clone") worktree move $(q "$dir") $(q "${clone%/*}/$folder")\`."
}

cmd_get() {
	if [ $# -ne 1 ] || [ "${1#-}" != "$1" ]; then
		die "ken get takes one repo key or git URL, got $(q "$(redact "$*")")." \
			'Run e.g. `ken get github.com/acme/join-web`, or `ken get --help`.'
	fi
	parse_key "$1"
	version=$(git --version 2>/dev/null) ||
		die "git is not on PATH, and ken get clones with it. Install git 2.48 or newer" \
			"(e.g. \`brew install git\`), then run \`ken get $KEY\` again."
	major=${version#git version } minor=${version#git version *.}
	major=${major%%[!0-9]*} minor=${minor%%[!0-9]*}
	if [ "${major:-0}" -lt 2 ] || { [ "$major" -eq 2 ] && [ "${minor:-0}" -lt 48 ]; }; then
		die "$version is too old: ken needs git 2.48 or newer, for worktree.useRelativePaths, which" \
			"lets a whole <owner>/ folder move. Install it (e.g. \`brew install git\`), check" \
			"\`git --version\`, then run \`ken get $KEY\` again."
	fi
	find_root
	filter=--filter=blob:none
	case $(sed -n '/^clone\.blobless=/{s/^[^=]*=[[:space:]]*//;s/[[:space:]]*$//;p;}' "$SCOPE/.ken" 2>/dev/null | tail -n 1) in
	'' | true) ;;
	false) filter= ;;
	*) die "$SCOPE/.ken sets clone.blobless to neither true nor false, so ken cannot tell how to clone." \
		"Fix that line to clone.blobless=false or true, then run \`ken get $KEY\` again." ;;
	esac
	clone=$TOP/.repos/$KEY parent=$TOP/.repos/${KEY%/*}
	for at in "$TOP/.repos" "${parent%/*}" "$parent"; do
		if [ -L "$at" ]; then
			to=$(readlink "$at")
			case $to in /*) ;; *) to=$(dir_of "$at")/$to ;; esac
			die "$at is a symlink to $to, so a clone under it would be outside the top root $TOP," \
				"whose .repos/ holds every checkout so that context cascades along its real path." \
				"Put the folder in its place, \`rm $(q "$at") && mv $(q "$to") $(q "$at")\`, or start an" \
				"empty one, \`rm $(q "$at")\`; then run \`ken get $KEY\` again."
		fi
	done
	# every get marks itself before the claim, so one that loses the mkdir waits while the
	# winner lives: its clone is whole once the mark is gone
	mark=$parent/.${KEY##*/}.ken-get.$$
	if ! mkdir -p -- "$mark"; then
		die "could not make $parent (the reason is above), so $KEY has no folder to be cloned into." \
			"Fix that, then run \`ken get $KEY\` again."
	fi
	trap 'rmdir "$mark" 2>/dev/null || :' EXIT
	if made=$(mkdir -- "$clone" 2>&1); then
		trap 'rm -rf "$clone"; exit 1' INT TERM HUP
		if ! err=$(git clone -q ${filter:+"$filter"} -- "$URL" "$clone" 2>&1); then
			rm -rf "$clone"
			hint=
			case $1 in *:*) ;; *)
				hint="A key alone clones https://$KEY.git; for another remote pass its URL, e.g."
				hint="$hint \`ken get git@${KEY%%/*}:${KEY#*/}.git\`. "
				;;
			esac
			die "could not clone $(redact "$URL") into $clone, so it was removed again. git said:" \
				"$(redact "$err")$nl${hint}Fix the cause, then run \`ken get $(q "$(redact "$1")")\` again."
		fi
		trap - INT TERM HUP
	else
		rmdir "$mark"
		if absent "$clone"; then
			die "could not make $clone: $made. Fix that, then run \`ken get $KEY\` again."
		fi
		busy=1
		while [ -n "$busy" ]; do
			busy=
			for at in "$parent/.${KEY##*/}.ken-get."*; do
				pid=${at##*.}
				case $pid in '' | *[!0-9]*) continue ;; esac
				if kill -0 "$pid" 2>/dev/null; then busy=1; fi
			done
			if [ -n "$busy" ]; then sleep 1; fi
		done
	fi
	what=
	if [ -L "$clone" ]; then
		what="a symlink to $(readlink "$clone")"
	elif absent "$clone"; then
		die "$clone is gone: another \`ken get $KEY\` was cloning into it and failed, saying why in" \
			"its own output. Run \`ken get $KEY\` again to clone it here."
	elif [ ! -d "$clone" ]; then
		what='a file'
	elif absent "$clone/.git"; then
		what='a folder with no .git'
	elif [ -L "$clone/.git" ] || [ ! -d "$clone/.git" ]; then
		what='a checkout whose .git is not a folder: a worktree, or a repo kept elsewhere'
	elif [ "$(git -C "$clone" rev-parse --absolute-git-dir 2>/dev/null)" != "$clone/.git" ]; then
		what='a folder whose .git git does not take as its repo'
	fi
	if [ -n "$what" ]; then
		init=
		if [ "$what" = 'a folder with no .git' ]; then
			init=" To make this folder the repo instead, run \`git init $(q "$clone")\` then \`ken get $KEY\`."
		fi
		die "$clone is where the clone of $KEY belongs, but it is $what, so ken neither uses nor" \
			"replaces it. Move it aside, e.g. \`mv $(q "$clone") ~/${KEY##*/}.aside\`, then run" \
			"\`ken get $KEY\` again.$init"
	fi
	if ! git -C "$clone" config --get worktree.useRelativePaths >/dev/null; then
		git -C "$clone" config worktree.useRelativePaths true
	fi
	git -C "$clone" worktree repair >&2
	file=$SCOPE/.repos/index
	listed=$(index_read stanza "$file" "$KEY") || exit 1
	if [ -z "$listed" ]; then
		layers=$(reachable "$SCOPE") || exit 1
		for layer in $layers; do
			listed=$(index_read stanza "$TOP/.repos/$layer/.repos/index" "$KEY") || exit 1
			if [ -n "$listed" ]; then break; fi
		done
	fi
	if [ -z "$listed" ]; then
		index_write set "$file" "$KEY" ''
		printf 'ken: %s %s\n' "registered $KEY in $file with no desc, and a desc is what lets an agent" \
			"choose a repo before cloning it. Run \`ken index set $KEY desc=\"...\"\` with what it is, in a line." >&2
	fi
	printf '%s\n' "$clone"
}

cmd_index() {
	sub=${1-}
	case $sub in set | unset) ;; *)
		die "ken index takes set or unset, then a repo key, got $(q "$(redact "$sub")")." \
			'Run e.g. `ken index set github.com/acme/join-web desc="Front end for the join funnel."`,' \
			'or `ken index --help` for the forms.'
		;;
	esac
	if [ $# -lt 2 ]; then die "ken index $sub needs a repo key. Run \`ken index --help\` for the forms."; fi
	parse_key "$2"
	shift 2
	find_root
	file=$SCOPE/.repos/index
	if [ "$sub" = set ]; then
		if [ $# -eq 0 ]; then
			die "ken index set $KEY needs at least one <field>=<value> to write." \
				"Run e.g. \`ken index set $KEY desc=\"What it is, in a line.\"\`."
		fi
		list='' set=''
		for arg; do
			field=${arg%%=*} value=${arg#*=}
			case $arg in *=*) ;; *) field='' ;; esac
			case $field in '' | *[!A-Za-z0-9_-]* | repo)
				die "$(q "$(redact "$arg")") is not a <field>=<value> ken index set can write: a field" \
					"name is letters, digits, _ and -, and repo is the entry's key line, not a field." \
					"Run e.g. \`ken index set $KEY kind=frontend\`."
				;;
			esac
			case $value in *"$nl"*)
				die "the value of $field has a newline, and an index value is one line." \
					"Write longer text in a page, then run \`ken index set $KEY doc=<path>\`."
				;;
			esac
			case $value in *[![:space:]]*) ;; *)
				unset_it=", or \`ken index unset $KEY $field\` to remove it"
				if [ "$field" = desc ]; then unset_it=''; fi
				die "the value of $field is empty, and an empty field says nothing." \
					"Run \`ken index set $KEY $field=<value>\` with a value$unset_it."
				;;
			esac
			list=$list$field=$value$nl
			case ", $set, " in *", $field, "*) ;; *) set="${set:+$set, }$field" ;; esac
		done
		entry=$(index_read stanza "$file" "$KEY") || exit 1
		index_write set "$file" "$KEY" "$list"
		if [ -n "$entry" ]; then entry='the entry'; else entry='a new entry'; fi
		printf 'Set %s in %s for %s, in %s.\n' "$set" "$entry" "$KEY" "$file"
		return
	fi
	entry=$(index_read stanza "$file" "$KEY") || exit 1
	if [ -z "$entry" ]; then
		die "$KEY has no entry in $file, so there is nothing to unset. Run" \
			"\`grep '^repo: ' $(q "$file")\` for the repos it lists; for a layer's entry, cd into the layer."
	fi
	has=$(printf '%s\n' "$entry" | sed -n '2,$s/: .*//p' | tr '\n' ' ')
	for field; do
		if [ "$field" = desc ]; then
			die "ken index unset does not remove desc alone: it says what $KEY is, before anyone" \
				"clones it. Run \`ken index set $KEY desc=\"...\"\` to change it, or" \
				"\`ken index unset $KEY\` to remove the whole entry."
		fi
		known=''
		case " $has" in *" $field "*) known=1 ;; esac
		case $field in *[!A-Za-z0-9_-]*) known='' ;; esac
		if [ -z "$known" ]; then
			fields=$(printf '%s' "$has" | sed 's/ $//; s/ /, /g')
			die "the entry for $KEY in $file has no $(q "$(redact "$field")"), so ken cannot remove it;" \
				"its fields are ${fields:-none}. Run \`ken index unset $KEY <field>...\` with those," \
				"or \`ken index unset $KEY\` to remove the whole entry."
		fi
	done
	if [ $# -eq 0 ]; then
		index_write drop "$file" "$KEY"
		printf 'Removed the entry for %s from %s.\n' "$KEY" "$file"
	else
		index_write unset "$file" "$KEY" "$*"
		printf 'Removed %s from the entry for %s, in %s.\n' "$(printf '%s' "$*" | sed 's/ /, /g')" "$KEY" "$file"
	fi
}

cmd_help() {
	if [ $# -gt 1 ]; then die 'ken help takes one command. Run e.g. `ken help path`.'; fi
	if [ $# -eq 1 ]; then
		if about "$1"; then
			full_help
			return
		fi
		shown=$(q "$(redact "$1")")
		die "$shown is not a builtin, so ken help has no page for it. If it is an external" \
			"command, run \`ken $shown --help\`; run \`ken help\` for every command."
	fi
	cat <<'EOF'
ken: the kernel of a ken root, a workspace that is a knowledge base with every checkout
inside it at .repos/<host>/<owner>/<repo>, and each branch beside it at <repo>.<branch>.

Usage: ken <command> [<args>]

Commands:
EOF
	for name in $BUILTINS; do
		about "$name"
		printf '  %s\n' "$usage"
		indent '      ' "$summary$nl$examples"
	done
	cat <<'EOF'
  <name> [<args>]
      Run the first executable ken-<name> in the scope's .bin/, each direct layer's .bin/
      in .ken order, then PATH, with KEN_ROOT set to the scope. A builtin always wins.

EOF
	if err=$({ find_root && places; } 2>&1); then
		find_root
		places
		externals
		printf '\nHere the scope is %s and the top is %s.\n' "$SCOPE" "$TOP"
	else
		printf 'External commands: none listed, because %s\n' "${err#ken: }"
	fi
	cat <<'EOF'
The scope is KEN_ROOT, else the nearest folder holding .ken above the current one, else the
root this ken lives in (<root>/.bin/ken, through a symlink on PATH), else ~/ken.
Run `ken <command> --help` for its forms.
EOF
}

# --- external commands (PRD decision 10)

# Sets PLACES: where ken-<name> is looked for, in order, one "<folder><tab><from>" per line:
# the scope's .bin/, each direct layer's in .ken order, then PATH. find_root has run.
places() {
	PLACES="$SCOPE/.bin${tab}the scope"
	layers=$(layer_lines "$SCOPE") || exit 1
	while IFS=$tab read -r layer key; do
		if [ -n "$layer" ]; then PLACES=$PLACES$nl$TOP/.repos/$key/.bin${tab}layer\ $layer; fi
	done <<EOF
$layers
EOF
	set -f
	IFS=:
	# an empty PATH entry is the current folder, as in any shell; the : added keeps a last one
	search=$PATH:
	for entry in $search; do PLACES=$PLACES$nl${entry:-.}${tab}PATH; done
	unset IFS
	set +f
}

# Prints the external commands `ken <name>` runs, by where each was found. places has run.
externals() {
	seen=" $BUILTINS " found=
	while IFS=$tab read -r dir from; do
		names=
		for file in "$dir"/ken-*; do
			name=${file##*/ken-}
			if [ -n "$name" ] && [ -f "$file" ] && [ -x "$file" ]; then
				case $seen in
				*" $name "*) ;;
				*) seen="$seen$name " names="$names, $name" ;;
				esac
			fi
		done
		if [ -n "$names" ]; then found="$found$nl  $from, $dir: ${names#, }"; fi
	done <<EOF
$PLACES
EOF
	if [ -n "$found" ]; then
		printf 'External commands, run as `ken <name>`, by where their ken-<name> was found:%s\n' "$found"
	else
		printf 'External commands: none found. Add one as an executable ken-<name> in %s.\n' "$SCOPE/.bin"
	fi
}

# Runs the first executable ken-$1 found with the rest of the arguments, by exec, so signals and
# the exit code are its own, with KEN_ROOT the real scope.
dispatch() {
	name=$1
	shift
	find_root
	places
	run='' plain='' looked=''
	while IFS=$tab read -r dir from; do
		looked="$looked$nl  $dir  ($from)"
		file=$dir/ken-$name
		case $name in '' | */*) continue ;; esac
		if [ -f "$file" ] && [ -x "$file" ]; then
			run=$file
			break
		fi
		if [ -f "$file" ] && [ -z "$plain" ]; then plain=$file; fi
	done <<EOF
$PLACES
EOF
	if [ -n "$run" ]; then
		KEN_ROOT=$SCOPE
		export KEN_ROOT
		exec "$run" "$@"
	fi
	shown=$(q "$(redact "$name")")
	if [ -n "$plain" ]; then
		die "$plain would run as \`ken $shown\`, but it is not executable." \
			"Run \`chmod +x $(q "$plain")\`, then \`ken $shown\` again."
	fi
	die "$shown is not a ken command, and no executable ken-<name> by that name was found." \
		"Looked in, in order:$looked${nl}Run \`ken help\` for the builtins and the external commands" \
		"found, or add an executable ken-<name> in $SCOPE/.bin."
}

# --- main

command=${1-help}
if [ $# -gt 0 ]; then shift; fi
case $command in -h | --help) command=help ;; esac
if about "$command"; then
	for arg; do
		case $arg in -h | --help)
			full_help
			exit 0
			;;
		esac
	done
	"cmd_$command" "$@"
else
	dispatch "$command" "$@"
fi
