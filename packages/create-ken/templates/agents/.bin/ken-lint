#!/usr/bin/env node
// `ken lint`: is the knowledge base still safe to read top down? Over the root's sections and
// each layer's, through the layer links, skipping hidden entries: every page in exactly one
// section README.md, every Markdown link and code reference resolving, the caps, and old pages
// nobody links to, proposed for .archive/. Exit 1 on an error, 0 with notes only.
// See "The knowledge base" in docs/prd.md of github.com/xiaoxinghu/ken.
import { spawnSync } from 'node:child_process'
import { existsSync, readdirSync, readFileSync, realpathSync, statSync } from 'node:fs'
import { basename, dirname, join, relative, resolve } from 'node:path'

// The caps, in lines, and the age of a page nobody links to before it is proposed for
// .archive/. The one place to change them.
const FRONT_PAGE_MAX = 60
const SECTION_README_MAX = 150
const AGENTS_MAX = 40
const STALE_DAYS = 365

const root = process.env.KEN_ROOT
if (!root) {
	console.error('ken-lint: KEN_ROOT is not set, so there is no root to check. Run it as `ken lint`.')
	process.exit(1)
}
const ken = (...args) => spawnSync('ken', args, { encoding: 'utf8' })
const cfg = ken('config', '--json')
if (cfg.status !== 0) {
	console.error(`ken-lint: \`ken config --json\` failed, so the layers are unknown:\n${cfg.stderr}`)
	process.exit(1)
}
const config = JSON.parse(cfg.stdout)
// the task folder holds tasks, not pages; an offline layer has nothing to read
const taskFolder = resolve(root, config.task?.folder ?? 'tasks')
const layers = config.layers.filter((l) => l.cloned && l.linked)

const problems = []
const report = (kind, file, text) => problems.push(`${kind}: ${relative(root, file)}: ${text}`)
const lines = (file) => {
	const text = readFileSync(file, 'utf8')
	return text.split('\n').length - (text.endsWith('\n') ? 1 : 0)
}
const cap = (file, max, why) => {
	if (existsSync(file) && lines(file) > max) {
		report('error', file, `${lines(file)} lines, over the cap of ${max}. ${why}`)
	}
}

// The walk, as `find -L`: links followed, a folder reached twice read once.
// a page by its real path, so a link reaching it by another path still finds it
const pages = new Map() // real path -> { path, the section READMEs that list it }
const readmes = []
const topOf = new Map() // file -> the root or layer it is in
const seen = new Set()
function walk(dir, top) {
	if (dir === taskFolder || seen.has(realpathSync(dir))) return
	seen.add(realpathSync(dir))
	for (const name of readdirSync(dir).sort()) {
		const path = join(dir, name)
		const stat = statSync(path, { throwIfNoEntry: false })
		if (name.startsWith('.') || !stat) continue
		if (stat.isDirectory()) walk(path, top)
		else if (name === 'README.md') readmes.push(path)
		else if (name.endsWith('.md')) pages.set(realpathSync(path), { path, listedBy: [] })
		topOf.set(path, top)
	}
}
const tops = [root, ...layers.map((l) => join(root, l.name))]
for (const top of tops) {
	seen.add(realpathSync(top))
	for (const name of readdirSync(top).sort()) {
		const path = join(top, name)
		if (name.startsWith('.') || tops.includes(path)) continue
		if (statSync(path, { throwIfNoEntry: false })?.isDirectory()) walk(path, top)
	}
	topOf.set(join(top, 'README.md'), top)
	cap(
		join(top, 'README.md'),
		FRONT_PAGE_MAX,
		'The front page is read first for every question: keep one line per section and layer and the few evergreen pages, and move the rest into pages.'
	)
}
cap(
	join(root, 'AGENTS.md'),
	AGENTS_MAX,
	'It is loaded on every turn: keep the non-obvious only, and move the rest into a page.'
)
for (const readme of readmes) {
	cap(
		readme,
		SECTION_README_MAX,
		`Split the section: move groups of pages into subfolders, each with its own README.md, and list the subfolders in ${relative(root, readme)}.`
	)
}

// Links and code references, in the front pages, the section READMEs and the pages.
// an inline link's target, or a reference-style link's definition, `[name]: target`, not a
// footnote's, `[^1]: text`; balanced parentheses and backslash escapes in it, as CommonMark
const LINK = /(?:\]\(|^ {0,3}\[(?!\^)[^\]]+\]:)\s*(?:<([^>]*)>|((?:\\.|[^()\s\\]|\([^()\s]*\))+))/gm
// `<host>/<owner>/<repo>:<path>`, each part as `ken path` takes it; a `*` is bold, not a path
const REFERENCE = /(?<![\w./:-])([\w-][\w.-]*\/[\w.-]+\/[\w.-]+):([^\s`'"<>#,;*]+)/gi
// a path keeps its brackets, `src/app/[id]/page.ts`, but not the punctuation after it, nor a
// `)` or `]` that closes the prose or the link around it
const trimPath = (path) => {
	const p = path.replace(/[.:!?]+$/, '')
	const open = { ')': '(', ']': '[' }[p.at(-1)]
	const count = (c) => p.split(c).length
	return open && count(open) < count(p.at(-1)) ? trimPath(p.slice(0, -1)) : p
}
// a link in code is an example, not a link: a fenced block, to its closing fence or the end,
// and an inline span, closed by a run of as many backticks within its paragraph. Not an
// indented block: without a parser it is a nested list item.
const CODE =
	/^ {0,3}(`{3,}|~{3,}).*$[\s\S]*?(?:^ {0,3}\1.*$|(?![\s\S]))|(?<!`)(`+)(?!`)(?:(?!\n\s*\n)[\s\S])*?[^`]\2(?!`)/gm
const inbound = new Set() // real paths of pages some front page or page links to
const paths = new Map() // code reference -> `ken path` of it
const uncloned = new Map() // key -> references into it not checked
const front = tops.map((t) => join(t, 'README.md')).filter((f) => existsSync(f))
for (const file of [...front, ...readmes, ...[...pages.values()].map((p) => p.path)]) {
	const text = readFileSync(file, 'utf8')
	const isSectionReadme = readmes.includes(file)
	const listed = new Set()
	for (const m of text.replace(CODE, '').matchAll(LINK)) {
		const target = m[1] ?? m[2]
		// a URL, an anchor, or a code reference, checked below
		if (/^[a-z][a-z0-9+.-]*:|^#|^\/\/|^[^/:]+\/[^/:]+\/[^/:]+:/i.test(target)) continue
		let path = target.replace(/[#?].*$/, '').replace(/\\(.)/g, '$1')
		try {
			path = decodeURIComponent(path)
		} catch {}
		const to = path.startsWith('/') ? join(topOf.get(file), path) : resolve(dirname(file), path)
		if (!existsSync(to)) {
			report('error', file, `links to ${target}, which does not exist. Fix the path, or remove the link.`)
			continue
		}
		const real = realpathSync(to)
		if (pages.has(real) && isSectionReadme) listed.add(real)
		else if (real !== realpathSync(file)) inbound.add(real)
	}
	for (const page of listed) pages.get(page).listedBy.push(file)
	for (const m of text.matchAll(REFERENCE)) {
		const [key, path] = [m[1], trimPath(m[2])]
		const ref = `${key}:${path}`
		if (!paths.has(ref)) paths.set(ref, ken('path', ref))
		const r = paths.get(ref)
		const out = r.stdout.trim()
		if (r.status !== 0) report('error', file, `\`ken path ${ref}\` failed: ${r.stderr.trim()}`)
		else if (out.startsWith('https://')) uncloned.set(key, (uncloned.get(key) ?? 0) + 1)
		else if (!existsSync(out)) {
			report(
				'error',
				file,
				`${ref} names a file not in the clone. Find where it went, \`git -C "$(ken path code ${key})" log --oneline -- ${path}\`, and fix the reference.`
			)
		}
	}
}

for (const [real, { path: page, listedBy }] of pages) {
	if (listedBy.length === 0) {
		report(
			'error',
			page,
			`listed in no section README.md, so an agent reading down from the front page never finds it. Add a line \`- [${basename(page, '.md')}](${basename(page)}): <what it says>\` to ${relative(root, join(dirname(page), 'README.md'))}, making it if missing.`
		)
	} else if (listedBy.length > 1) {
		report(
			'error',
			page,
			`listed in ${listedBy.length} section READMEs, ${listedBy.map((f) => relative(root, f)).join(' and ')}; a page has one home. Keep its line in one and drop it from the others.`
		)
	}
	if (inbound.has(real)) continue
	const log = spawnSync('git', ['log', '-1', '--format=%ct', '--', basename(page)], {
		cwd: dirname(real),
		encoding: 'utf8'
	})
	const changed = Number(log.stdout.trim()) * 1000
	if (!changed || Date.now() - changed < STALE_DAYS * 86_400_000) continue
	const top = topOf.get(page)
	const cd = top === root ? 'ken path root' : `ken path layer ${basename(top)}`
	const rel = relative(top, page)
	report(
		'note',
		page,
		`nobody links to it and nobody has changed it since ${new Date(changed).toISOString().slice(0, 10)}. If it is settled, propose archiving it: \`cd "$(${cd})" && mkdir -p ${join('.archive', dirname(rel))} && git mv ${rel} ${join('.archive', rel)}\`, then drop its line from its README.md.`
	)
}

for (const p of problems) console.log(p)
if (uncloned.size) {
	const keys = [...uncloned.keys()]
	const count = [...uncloned.values()].reduce((a, b) => a + b, 0)
	console.log(
		`note: not checked: ${count} code references into ${keys.join(', ')}, not cloned here. To check them, run ${keys.map((k) => `\`ken get ${k}\``).join(' and ')}, then \`ken lint\` again.`
	)
}
const errors = problems.filter((p) => p.startsWith('error:')).length
console.log(
	errors
		? `ken lint: ${errors} errors in ${pages.size} pages. Fix each as it says, then run \`ken lint\` again.`
		: `ken lint: no errors in ${pages.size} pages.`
)
process.exit(errors ? 1 : 0)
