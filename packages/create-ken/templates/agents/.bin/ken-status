#!/bin/sh
# The session-start hook, run as `ken status`: one screen of what this root holds, so the
# agent never lists folders. Its output is the agent's context, the errors included.
ken repos 2>&1
echo
ken config 2>&1
if command -v ken-task >/dev/null 2>&1; then
	echo
	ken task ready 2>&1
fi
exit 0
