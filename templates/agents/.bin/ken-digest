#!/bin/sh
# `ken digest [<transcript>]`: writes the root's record of one agent session,
# .sessions/<id>.jsonl, from the harness's transcript, KEN_SESSION_TRANSCRIPT or the argument,
# whole each time, so running it twice gives the same file. A header line, then one entry per
# line in the ghost's shape (justfiles:packages/ghost/mirror.ts#MirroredEntry): the user's
# prompts, the agent's replies with their tool calls, a name and the head of the input, and
# compactions, in transcript order; never tool results, attachments, system reminders, thinking
# or images: they are the bulk and where secrets live. `ken session` reads it. `ken log` runs
# it before each line it tags with `s=<id>`.
# A missing or unreadable transcript, or no jq, is a message and exit 0, so `ken log` still logs.
if [ -z "${KEN_ROOT-}" ]; then
	echo "ken digest: KEN_ROOT is not set, so the root is unknown. Run it as \`ken digest\`, which sets it." >&2
	exit 2
fi
t=${1:-${KEN_SESSION_TRANSCRIPT-}}
if [ -z "$t" ]; then
	echo "ken digest: no transcript: KEN_SESSION_TRANSCRIPT is unset and none was given, so no digest was written. The session-start hook sets it; \`ken digest <transcript>\` names one." >&2
	exit 0
fi
if [ ! -r "$t" ]; then
	echo "ken digest: the transcript $t cannot be read, so no digest was written: the harness may have deleted it." >&2
	exit 0
fi
if ! command -v jq >/dev/null 2>&1; then
	echo "ken digest: jq is not installed, so no digest was written. The transcript is JSON lines and jq reads them: \`brew install jq\` or \`apt install jq\`, then \`ken digest $t\` writes this session's." >&2
	exit 0
fi
# The format: pi's session header or Codex's session_meta is the first line; Claude Code's
# entries carry sessionId, though the first may be a file-history snapshot that has none.
case $(head -n 1 "$t") in
*'"type":"session"'*) harness=pi ;;
*'"type":"session_meta"'*) harness=codex ;;
*) harness=claude-code ;;
esac
if [ $harness = claude-code ] && ! grep -q '"sessionId"' "$t"; then
	echo "ken digest: $t is no transcript ken reads (Claude Code, pi or Codex), so no digest was written." >&2
	exit 0
fi
mkdir -p "$KEN_ROOT/.sessions" || exit 1
tmp=$KEN_ROOT/.sessions/.digest.$$
# The transcript is read raw and split at newlines, so a line that is not JSON, one still being
# written, is skipped rather than failing the whole file. Each transcript entry becomes at most
# one entry, `mid` and `join` saying which assistant entries are one reply; then the replies are
# merged, an entry with nothing in it dropped, and `id` and `at` given.
jq -R -s -c --arg harness "$harness" '
def clean: sub("^[ \\t\\n]+"; "") | sub("[ \\t\\n]+$"; "");
def time: if type == "string" and . != "" then . else null end;
# Harness-made text, a background task finishing, a command output, a reminder, is not the user speaking.
def spoken:
  (test("^<(task-notification|bash-stdout|local-command-)") | not)
  and ($harness != "codex" or (test("^(<(environment_context|user_instructions|external_codex_apps_open_page)>|# AGENTS\\.md instructions)") | not));
# A user message: its text, a string or text blocks; a reminder the harness put in a prompt is
# cut out, wherever it sits.
def user($content; $at):
  [ ($content | if type == "string" then . else (.[]? | select(.type == "text" or .type == "input_text") | .text) end)
    | strings | gsub("<system-reminder>.*?</system-reminder>"; ""; "m") | clean | select(length > 0 and spoken) ]
  | if length == 0 then empty else {kind: "user", text: join("\n\n"), at: ($at | time)} end;
# A tool call: its name and its input as JSON text, cut at 120 characters.
def call($id; $name; $input):
  {id: ($id // ""), name: ($name // ""),
   input: ($input | if type == "string" then . else tojson end | if length > 120 then .[:120] + "…" else . end)};
def assistant($content; $at; $mid):
  {kind: "assistant",
   text: ([$content | .[]? | select(.type == "text" or .type == "output_text") | (.text // "") | clean | select(. != "")] | join("\n\n")),
   toolCalls: [$content | .[]? | if .type == "tool_use" then call(.id; .name; .input)
                                 elif .type == "toolCall" then call(.id; .name; .arguments) else empty end],
   at: ($at | time), mid: $mid};
def note($summary; $at): {kind: "compaction", summary: $summary, at: ($at | time)};
# Claude Code: entries in file order, one per content block, a reply its entries sharing
# message.id; isMeta text is the harness speaking, a compact summary is the model rewriting the
# past, and a rewound branch stays in the file and in the digest.
def claude:
  if .type == "system" and .subtype == "compact_boundary" then note("(compacted here)"; .timestamp)
  elif .type == "user" and .isMeta != true and .isCompactSummary != true then user(.message.content; .timestamp)
  elif .type == "assistant" then
    assistant(.message.content; .timestamp; .message.id)
    + (if .isApiErrorMessage == true then {error: (.error // "error")} else {} end)
  else empty end;
# pi: a tree, id and parentId; the digest is the path from the last entry back to the root.
def pi:
  if .type == "compaction" then note("(compacted here)"; .timestamp)
  elif .type == "branch_summary" then note("(branched here: the path below left another)"; .timestamp)
  elif .type == "message" and .message.role == "user" then user(.message.content; .timestamp)
  elif .type == "message" and .message.role == "assistant" then
    assistant(.message.content; .timestamp; null)
    + (if .message.stopReason == "error" or .message.stopReason == "aborted"
       then {error: (.message.errorMessage // .message.stopReason)} else {} end)
  else empty end;
def pi_path:
  (map(select(has("id"))) | map({key: (.id | tostring), value: .}) | from_entries) as $by
  | [ {id: (map(select(has("id")))[-1].id // "" | tostring), seen: {}, path: []}
      | until(.id == "" or .seen[.id]; .seen[.id] = true | .path += [.id] | .id = ($by[.id].parentId // "" | tostring))
      | .path[] ] | reverse | map($by[.]);
# Codex: the response items in file order; a tool call is an item of its own, joined to the
# reply before it.
def codex:
  if .type == "compacted" then note("(compacted here)"; .timestamp)
  elif .type != "response_item" then empty
  elif .payload.type == "message" and .payload.role == "user" then user(.payload.content; .timestamp)
  elif .payload.type == "message" and .payload.role == "assistant" then assistant(.payload.content; .timestamp; null)
  elif .payload.type == "custom_tool_call" or .payload.type == "function_call" then
    {kind: "assistant", text: "", toolCalls: [call(.payload.call_id; .payload.name; .payload.input // .payload.arguments)],
     at: (.timestamp | time), join: true}
  else empty end;
def merge:
  reduce .[] as $e ([];
    (length - 1) as $i
    | if $e.kind == "assistant" and $i >= 0 and .[$i].kind == "assistant"
         and ($e.join == true or ($e.mid != null and $e.mid == .[$i].mid))
      then .[$i] |= (.text = ([.text, $e.text] | map(select(. != "")) | join("\n\n"))
                     | .toolCalls += $e.toolCalls
                     | if $e.error then .error = $e.error else . end)
      else . + [$e] end)
  | map(select(.kind != "assistant" or .text != "" or (.toolCalls | length) > 0 or .error));
# An entry without a time takes the one before it, the first the time the session started.
def number($started):
  reduce .[] as $e ({n: 0, at: ($started // ""), out: []};
    .n += 1 | .at = ($e.at // .at)
    | .out += [{id: .n, at: .at, kind: $e.kind} + ($e | del(.at, .kind, .mid, .join))])
  | .out[];
def emit($session; $started; $cwd; entries):
  {kind: "session", session: ($session // ""), harness: $harness, started: ($started // ""), cwd: ($cwd // "")},
  ([entries] | merge | number($started | time));
split("\n") | map(select(length > 0) | fromjson? | select(type == "object"))
| if $harness == "pi" then
    (.[0] as $h | emit($h.id; $h.timestamp; $h.cwd; pi_path | .[] | pi))
  elif $harness == "codex" then
    (.[0].payload as $h | emit($h.id; $h.timestamp; $h.cwd; .[] | codex))
  else
    emit(first(.[] | .sessionId | strings); first(.[] | .timestamp | strings); first(.[] | .cwd | strings); .[] | claude)
  end
' "$t" >"$tmp" || {
	rm -f "$tmp"
	echo "ken digest: reading $t failed, so no digest was written." >&2
	exit 1
}
# The session ken log tags its line with; a transcript named by hand is its own session's.
id=$(head -n 1 "$tmp" | jq -r .session)
if [ $# -eq 0 ]; then
	id=${KEN_SESSION:-$id}
fi
case $id in
'' | .* | */* | *' '*)
	rm -f "$tmp"
	echo "ken digest: '$id' is no session id: it names the file .sessions/<id>.jsonl. KEN_SESSION is the harness's id, set by the session-start hook." >&2
	exit 2
	;;
esac
mv "$tmp" "$KEN_ROOT/.sessions/$id.jsonl"
