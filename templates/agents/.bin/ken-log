#!/bin/sh
# `ken log <kind> <subject> <what...>`: appends one line to the root's log.md, the timeline the
# agents write as they act, `<time> <kind> <subject>: <what>`. The time is now, local, to the
# minute with its offset; BSD date has no %:z. One short line in one >> is atomic under
# O_APPEND, so sessions logging at once never tear a line. Prints nothing on success.
# In a session the start hook named, KEN_SESSION, it first writes the session's digest with
# `ken digest` and ends the line with ` s=<id>`, the link from the line to the story behind it.
kinds='ingest query page task promote layer'
nl='
'
tab='	'
usage="Usage: ken log <kind> <subject> <what...>, e.g. \`ken log query flow/README.md answered X\`.
<kind> is one of: $kinds. <subject> is one word grep finds the entry by: a repo key, a path
from the root, a task path, or <key>:<path>#<symbol>. <what> is one short clause. Log right
after an ingest, an answered question, a page, task, promote or layer change, before its commit."
if [ $# -lt 3 ]; then
	printf 'ken log: a kind, a subject and what happened are needed.\n%s\n' "$usage" >&2
	exit 2
fi
if [ -z "${KEN_ROOT-}" ]; then
	echo "ken log: KEN_ROOT is not set, so the root is unknown. Run it as \`ken log\`, which sets it." >&2
	exit 2
fi
kind=$1 subject=$2
shift 2
what=$*
case $kind in
ingest | query | page | task | promote | layer) ;;
*)
	printf "ken log: '%s' is not a kind: the kinds are a closed list, so grep ' <kind> ' finds them.\n%s\n" "$kind" "$usage" >&2
	exit 2
	;;
esac
case $subject in
'' | *' '* | *"$tab"* | *"$nl"*)
	printf "ken log: the subject '%s' is not one word: a line is split at its first spaces.\n%s\n" "$subject" "$usage" >&2
	exit 2
	;;
esac
case $what in
*"$nl"*)
	printf 'ken log: what happened spans lines: an entry is one line. Say it in one short clause.\n%s\n' "$usage" >&2
	exit 2
	;;
*[!" $tab"]*) ;;
*)
	printf 'ken log: what happened is empty.\n%s\n' "$usage" >&2
	exit 2
	;;
esac
# A harness with no env file has its hook write the session to a pointer instead, the
# root's under ~/.local/state/ken, as `ken status` names it.
pointer=${HOME-}/.local/state/ken/$(printf '%s' "$KEN_ROOT" | tr / -)
if [ -z "${KEN_SESSION-}" ] && [ -r "$pointer" ]; then
	KEN_SESSION=$(sed -n 's/^KEN_SESSION=//p' "$pointer")
	KEN_SESSION_TRANSCRIPT=$(sed -n 's/^KEN_SESSION_TRANSCRIPT=//p' "$pointer")
	export KEN_SESSION KEN_SESSION_TRANSCRIPT
fi
link=
if [ -n "${KEN_SESSION-}" ] && ken digest; then
	link=" s=$KEN_SESSION"
fi
printf '%s %s %s: %s%s\n' "$(date +%Y-%m-%dT%H:%M%z)" "$kind" "$subject" "$what" "$link" >>"$KEN_ROOT/log.md"
