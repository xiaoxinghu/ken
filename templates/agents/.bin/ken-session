#!/bin/sh
# `ken session <id> [<range>]` prints the digest of one agent session, .sessions/<id>.jsonl, the
# story behind a log.md line that ends in s=<id>: a header line, then the last 20 entries, or
# the range, one line per entry and per tool call, as the ghost's transcript tool shows them
# (justfiles:packages/ghost/transcript-tool.ts#transcriptTool). `ken session grep <pattern>`
# searches every digest, one `<id>:<n>:<kind> <text>` per entry that matches. A digest from
# before, .sessions/<id>.md, is printed whole and grepped by line. The folder is hidden, so a
# grep of the root skips it.
usage="Usage: \`ken session <id>\` prints the last entries of the digest a log.md line's s=<id>
names, \`ken session <id> <range>\` the entries in a range, 12, 12-30 or 1- for all;
\`ken session grep <pattern>\` searches every digest. Read a digest when its line is not enough;
never list or read .sessions/ whole."
nojq="ken session: jq is not installed, so the digest's JSON lines are printed raw. \`brew install jq\` or \`apt install jq\` makes them readable."
if [ -z "${KEN_ROOT-}" ]; then
	echo "ken session: KEN_ROOT is not set, so the root is unknown. Run it as \`ken session\`, which sets it." >&2
	exit 2
fi
dir=$KEN_ROOT/.sessions
command -v jq >/dev/null 2>&1 && jq=yes
# A line collapsed to one of 200 characters, and an ISO time as local time, `?` when it is none.
# shellcheck disable=SC2016
defs='
def collapse: gsub("\\s+"; " ") | sub("^ "; "") | sub(" $"; "") | if length > 200 then .[:200] + "…" else . end;
def local($f): (try (sub("\\.[0-9]+"; "") | fromdateiso8601) catch null) | if . == null then "?" else strflocaltime($f) end;
'
has() {
	for f in "$@"; do
		[ -e "$f" ] && return 0
	done
	return 1
}
case ${1-} in
'')
	printf 'ken session: a session id is needed.\n%s\n' "$usage" >&2
	exit 2
	;;
grep)
	if [ $# -ne 2 ]; then
		printf 'ken session grep: one pattern is needed, quoted if it has spaces.\n%s\n' "$usage" >&2
		exit 2
	fi
	pattern=$2
	set --
	if ! cd "$dir" 2>/dev/null || ! { has ./*.jsonl || has ./*.md; }; then
		echo "ken session grep: $dir holds no digest yet: \`ken log\` writes one in a session the start hook named." >&2
		exit 1
	fi
	found=
	if has ./*.jsonl && [ -n "${jq-}" ]; then
		if ! jq -n --arg p "$pattern" '"" | test($p)' >/dev/null 2>&1; then
			echo "ken session grep: '$pattern' is no pattern jq reads, a regular expression; quote what is meant literally." >&2
			exit 2
		fi
		# Everything an entry says: its text, and each tool call's name and input.
		found=$(jq -R -r --arg p "$pattern" "$defs"'
fromjson? | select(type == "object" and (.id | type) == "number")
| (if .kind == "user" then .text
   elif .kind == "assistant" then [.text, (.toolCalls[]? | "\(.name) \(.input)")] | join("\n")
   elif .kind == "compaction" then .summary
   else .handoff // "" end) as $said
| select($said | test($p))
| "\(input_filename | ltrimstr("./") | rtrimstr(".jsonl")):\(.id):\(.kind) \($said | collapse)"
' ./*.jsonl) || exit 1
	elif has ./*.jsonl; then
		echo "$nojq" >&2
		set -- *.jsonl
	fi
	has ./*.md && set -- "$@" *.md
	if [ $# -gt 0 ]; then
		# /dev/null makes grep name the file however many there are; 1 is no match, 2 a bad pattern
		lines=$(grep -n -e "$pattern" -- "$@" /dev/null)
		[ $? -gt 1 ] && exit 2
		[ -z "$lines" ] || found=$(printf '%s\n' "$found" "$lines" | sed -e '/^$/d' -e 's/^\([^:]*\)\.jsonl:/\1:/' -e 's/^\([^:]*\)\.md:/\1:/')
	fi
	[ -n "$found" ] || exit 1
	printf '%s\n' "$found"
	;;
.* | */*)
	printf "ken session: '%s' is no session id: it is the word after s= in a log.md line.\n%s\n" "$1" "$usage" >&2
	exit 2
	;;
*)
	range=${2-}
	case $range in
	-* | *[!0-9-]* | *-*-*)
		printf "ken session: '%s' is no range: entries 12, 12-30, or 1- for all.\n%s\n" "$range" "$usage" >&2
		exit 2
		;;
	esac
	if [ $# -gt 2 ]; then
		printf 'ken session: an id and at most a range are taken.\n%s\n' "$usage" >&2
		exit 2
	fi
	if [ -r "$dir/$1.jsonl" ]; then
		if [ -z "${jq-}" ]; then
			echo "$nojq" >&2
			cat "$dir/$1.jsonl"
			exit 0
		fi
		# An entry: its first line numbered and timed, a tool call a line of its own; a day line
		# before the first entry and where the day changes.
		exec jq -R -s -r --arg id "$1" --arg range "$range" "$defs"'
def render: "#\(.id) \(.at | local("%H:%M"))" as $head
  | if .kind == "user" then "\($head) user: \(.text)"
    elif .kind == "assistant" then
      (if .text == "" and (.toolCalls | length) > 0 then empty else "\($head) assistant: \(.text)" end),
      (.toolCalls[]? | "\($head) → \(.name) \(.input)" | collapse),
      (if .error then "\($head) (failed: \(.error))" else empty end)
    elif .kind == "reset" then "\($head) new session" + (if .handoff then ": \(.handoff)" else "" end)
    elif .kind == "compaction" then "\($head) compacted: \(.summary)" | collapse
    else empty end;
split("\n") | map(select(length > 0) | fromjson? | select(type == "object"))
| (map(select(.kind == "session"))[0] // {}) as $h
| map(select(.id | type == "number")) as $all
| ($all | length) as $n
| (if $range == "" then [$n - 19, $n]
   else $range | split("-") | [(.[0] | tonumber), (if length == 1 then .[0] | tonumber elif .[1] == "" then $n else .[1] | tonumber end)]
   end) as [$from, $to]
| [$all[] | select(.id >= $from and .id <= $to)] as $shown
| "Session \($h.session // $id), \($h.harness // "?"), started \($h.started // "" | local("%Y-%m-%d %H:%M")), \($n) entries"
  + (if $shown == [] then ", none in \($range): `ken session \($id) 1-` prints them all."
     elif ($shown | length) == $n then ", all shown."
     elif $range == "" then ", the last \($shown | length) shown: `ken session \($id) <range>` prints others, 12, 12-30, or 1- for all."
     else ", \($shown[0].id)-\($shown[-1].id) shown: `ken session \($id) 1-` prints all."
     end),
  (reduce $shown[] as $e ({day: null, out: []};
     ($e.at | local("%Y-%m-%d")) as $d
     | (if $d != .day then .out += [$d] else . end)
     | .day = $d | .out += [$e | render])
   | .out[])
' "$dir/$1.jsonl"
	fi
	if [ -r "$dir/$1.md" ]; then
		cat "$dir/$1.md"
		exit 0
	fi
	printf "ken session: no digest %s.jsonl in %s: check the id after s= in the log line, or \`ken session grep <pattern>\`.\n" "$1" "$dir" >&2
	exit 1
	;;
esac
