# The top of the direnv chain: .repos/<host>/<owner>/.envrc runs source_up_if_exists to
# reach it, so a worktree without an .envrc of its own gets the owner's and this one.

# Secrets for the whole root, kept out of git by .gitignore.
dotenv_if_exists

# A Unix socket path is capped at 104 bytes on macOS and worktree paths here run near 90,
# so each tool that makes a socket in its working folder is pointed under $TMPDIR instead.
tmp=${TMPDIR:-/tmp}
tmp=${tmp%/}
# overmind: one socket per folder whose .envrc loads this, named by a checksum of its path;
# a repo that runs overmind in two worktrees at once puts this line in its own .envrc.
export OVERMIND_SOCKET="$tmp/overmind-$(printf %s "$PWD" | cksum | cut -d' ' -f1).sock"
# postgres: a server started here puts its socket in $PGHOST, and psql looks for it there.
export PGHOST="$tmp"
# ssh: a ControlMaster socket for git, named by %C, a hash of the connection, so it stays short.
export GIT_SSH_COMMAND="ssh -o ControlPath=$tmp/ssh-%C"
